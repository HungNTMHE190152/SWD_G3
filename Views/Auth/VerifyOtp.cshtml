@model EduNexus.ViewModels.Authentication.VerifyOtpViewModel

@{
    ViewData["Title"] = "Verify OTP";
}

<div class="container">

    <div class="row justify-content-center mt-5">

        <div class="col-md-5">

            <div class="card shadow">

                <div class="card-body p-4">

                    <h2 class="text-center">

                        Verify OTP

                    </h2>

                    <p class="text-center text-muted">

                        Check your email and enter the OTP.

                    </p>

                    <form asp-action="VerifyOtp"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="Email" hidden />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">

                            <label asp-for="Otp"></label>

                            <input asp-for="Otp"
                                   class="form-control" />

                            <span asp-validation-for="Otp"
                                  class="text-danger"></span>

                        </div>

                        <button class="btn btn-success w-100">

                            Verify OTP

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}