@model EduNexus.ViewModels.Profile.EditProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">
            Account
        </div>

        <h2 class="page-title">
            Edit Profile
        </h2>

        <p class="page-description">
            Update your personal display information.
        </p>
    </div>

    <div class="page-actions">
        <a asp-area=""
           asp-controller="Profile"
           asp-action="Index"
           class="btn-app-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to profile
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-4">
        <div class="app-card">
            <div class="app-card-header">
                <div>
                    <h3 class="app-card-title">
                        Avatar preview
                    </h3>
                </div>
            </div>

            <div class="app-card-body text-center py-5">
                <img id="avatarPreview"
                     src="@Model.AvatarUrl"
                     alt="Avatar preview"
                     class="@(string.IsNullOrWhiteSpace(
                                              Model.AvatarUrl)
                                                 ? "d-none"
                                                 : "")"
                     style="
                        width: 130px;
                        height: 130px;
                        margin: 0 auto;
                        border-radius: 30px;
                        object-fit: cover;
                        border: 1px solid var(--border);
                     " />

                <div id="avatarPlaceholder"
                     class="@(string.IsNullOrWhiteSpace(
                                              Model.AvatarUrl)
                                                 ? ""
                                                 : "d-none")"
                     style="
                        width: 130px;
                        height: 130px;
                        margin: 0 auto;
                        align-items: center;
                        justify-content: center;
                        border-radius: 30px;
                        background: var(--accent-light);
                        color: var(--accent);
                        font-size: 48px;
                        display: flex;
                     ">

                    <i class="bi bi-person"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="app-card">
            <div class="app-card-header">
                <div>
                    <h3 class="app-card-title">
                        Profile information
                    </h3>

                    <p class="app-card-subtitle">
                        Email, username and role
                        cannot be changed here.
                    </p>
                </div>
            </div>

            <div class="app-card-body">
                <form asp-area=""
                      asp-controller="Profile"
                      asp-action="Edit"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="app-alert app-alert-danger mb-4">
                    </div>

                    <div class="mb-4">
                        <label asp-for="FullName"
                               class="form-label">
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               autocomplete="name" />

                        <span asp-validation-for="FullName"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber"
                               class="form-label">
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control"
                               autocomplete="tel" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AvatarUrl"
                               class="form-label">
                        </label>

                        <input asp-for="AvatarUrl"
                               id="avatarUrlInput"
                               class="form-control" />

                        <span asp-validation-for="AvatarUrl"
                              class="text-danger small">
                        </span>

                        <div class="form-text">
                            Leave blank to remove the avatar.
                        </div>
                    </div>

                    <div class="d-flex
                                justify-content-end
                                flex-wrap
                                gap-2">

                        <a asp-area=""
                           asp-controller="Profile"
                           asp-action="Index"
                           class="btn-app-secondary">

                            Cancel
                        </a>

                        <button type="submit"
                                class="btn-app-primary">

                            <i class="bi bi-check-lg"></i>
                            Save changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const avatarInput =
                    document.getElementById(
                        "avatarUrlInput");

                const avatarPreview =
                    document.getElementById(
                        "avatarPreview");

                const avatarPlaceholder =
                    document.getElementById(
                        "avatarPlaceholder");

                function showPlaceholder() {
                    avatarPreview.classList.add(
                        "d-none");

                    avatarPlaceholder.classList.remove(
                        "d-none");
                }

                function showPreview(url) {
                    avatarPreview.src =
                        url;

                    avatarPreview.classList.remove(
                        "d-none");

                    avatarPlaceholder.classList.add(
                        "d-none");
                }

                function updatePreview() {
                    const value =
                        avatarInput.value.trim();

                    if (!value) {
                        showPlaceholder();
                        return;
                    }

                    showPreview(value);
                }

                avatarPreview.addEventListener(
                    "error",
                    showPlaceholder);

                avatarInput.addEventListener(
                    "input",
                    updatePreview);
            });
    </script>
}