@{
    string currentRole =
        User.FindFirstValue(ClaimTypes.Role)
        ?? string.Empty;

    string roleCssClass = currentRole.ToLowerInvariant();

    string displayName =
        User.Identity?.Name
        ?? "EduNexus User";

    string currentArea =
        ViewContext.RouteData.Values["area"]?.ToString()
        ?? string.Empty;

    string currentController =
        ViewContext.RouteData.Values["controller"]?.ToString()
        ?? string.Empty;

    string pageTitle =
        ViewData["Title"]?.ToString()
        ?? "EduNexus";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - EduNexus</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/edunexus.css"
          asp-append-version="true" />
</head>

<body class="app-body role-@roleCssClass">
    <div class="app-shell">
        <aside class="app-sidebar"
               id="appSidebar">

            <div class="sidebar-brand">
                <a asp-area="@currentArea"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="brand-link">

                    <span class="brand-logo">
                        E
                    </span>

                    <span class="brand-text">
                        <strong>EduNexus</strong>
                        <small>Learning Management</small>
                    </span>
                </a>
            </div>

            <div class="sidebar-role">
                <span class="role-label">
                    Signed in as
                </span>

                <span class="role-name">
                    @currentRole
                </span>
            </div>

            <nav class="sidebar-navigation">
                <partial name="_RoleSidebar" />
            </nav>

            <div class="sidebar-user">
                <div class="user-avatar">
                    @displayName.Substring(0, 1).ToUpper()
                </div>

                <div class="user-information">
                    <strong title="@displayName">
                        @displayName
                    </strong>

                    <small>
                        @currentRole
                    </small>
                </div>
            </div>
        </aside>

        <div class="sidebar-overlay"
             id="sidebarOverlay">
        </div>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-left">
                    <button type="button"
                            class="sidebar-toggle"
                            id="sidebarToggle"
                            aria-label="Toggle sidebar">

                        <i class="bi bi-list"></i>
                    </button>

                    <div>
                        <h1 class="topbar-title">
                            @pageTitle
                        </h1>

                        <div class="topbar-breadcrumb">
                            <span>EduNexus</span>

                            @if (!string.IsNullOrWhiteSpace(currentArea))
                            {
                                <i class="bi bi-chevron-right"></i>
                                <span>@currentArea</span>
                            }

                            <i class="bi bi-chevron-right"></i>
                            <span>@currentController</span>
                        </div>
                    </div>
                </div>

                <div class="topbar-right">
                    <div class="topbar-date">
                        <i class="bi bi-calendar3"></i>

                        <span>
                            @DateTime.Now.ToString("dd MMM yyyy")
                        </span>
                    </div>

                    <div class="dropdown">
                        <button class="profile-button"
                                type="button"
                                data-bs-toggle="dropdown">

                            <span class="profile-avatar">
                                @displayName.Substring(0, 1).ToUpper()
                            </span>

                            <span class="profile-name">
                                @displayName
                            </span>

                            <i class="bi bi-chevron-down"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end
                                   profile-menu shadow-sm">

                            <li>
                                <a class="dropdown-item"
                                   asp-area=""
                                   asp-controller="Profile"
                                   asp-action="Index">

                                    <i class="bi bi-person me-2"></i>
                                    My Profile
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                <form asp-area=""
                                      asp-controller="Auth"
                                      asp-action="Logout"
                                      method="post">

                                    <button type="submit"
                                            class="dropdown-item text-danger">

                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-content">
                <partial name="_FlashMessages" />

                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>
                    © @DateTime.Now.Year EduNexus
                </span>

                <span>
                    Learning and Teaching Performance Management System
                </span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/edunexus.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false)
</body>
</html>