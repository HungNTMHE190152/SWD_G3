@model EduNexus.ViewModels.Flashcards.FlashcardSetListViewModel

@{
    ViewData["Title"] = "Flashcard Editor";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Flashcard Editor</h2>

            <p class="text-muted">
                Manage your Flashcard Sets and Flashcards
            </p>

        </div>

        <a asp-action="CreateSet"
           class="btn btn-primary">
            + New Flashcard Set
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>Set Name</th>

                        <th>Course</th>

                        <th>Total Cards</th>

                        <th>AI</th>

                        <th>Created</th>

                        <th width="180">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.FlashcardSets.Any())
                    {
                        @foreach (var item in Model.FlashcardSets)
                        {
                            <tr>

                                <td>@item.SetName</td>

                                <td>@item.CourseTitle</td>

                                <td>@item.TotalCards</td>

                                <td>

                                    @if (item.IsAIGenerated)
                                    {
                                        <span class="badge bg-success">
                                            AI
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Manual
                                        </span>
                                    }

                                </td>

                                <td>

                                    @(item.CreatedAt?.ToString("dd/MM/yyyy"))

                                </td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@item.FlashcardSetId"
                                       class="btn btn-primary btn-sm">

                                        Open

                                    </a>

                                    <a asp-action="EditSet"
                                       asp-route-id="@item.FlashcardSetId"
                                       class="btn btn-warning btn-sm">

                                        Edit

                                    </a>

                                    <button class="btn btn-danger btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteSetModal-@item.FlashcardSetId">

                                        Delete

                                    </button>

                                </td>

                            </tr>
                            <div class="modal fade"
                                 id="deleteSetModal-@item.FlashcardSetId"
                                 tabindex="-1"
                                 aria-hidden="true">

                                <div class="modal-dialog">

                                    <div class="modal-content">

                                        <form asp-action="DeleteSet"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="flashcardSetId"
                                                   value="@item.FlashcardSetId" />

                                            <div class="modal-header">

                                                <h5 class="modal-title">
                                                    Delete Flashcard Set
                                                </h5>

                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal">
                                                </button>

                                            </div>

                                            <div class="modal-body">

                                                <p>
                                                    Are you sure you want to delete this Flashcard Set?
                                                </p>

                                                <div class="alert alert-warning">

                                                    <strong>@item.SetName</strong>

                                                    <br />

                                                    This will also delete all flashcards inside this set.

                                                </div>

                                            </div>

                                            <div class="modal-footer">

                                                <button type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal">

                                                    Cancel

                                                </button>

                                                <button type="submit"
                                                        class="btn btn-danger">

                                                    Delete

                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6" class="text-center text-muted">

                                No Flashcard Set Found

                            </td>

                        </tr>

                    }


                </tbody>

            </table>

        </div>

    </div>

</div>