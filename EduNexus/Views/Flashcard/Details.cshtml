@model EduNexus.ViewModels.Flashcards.FlashcardEditorViewModel

@{
    ViewData["Title"] = "Flashcard Editor";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>@Model.SetName</h2>

            <p class="text-muted mb-1">
                Course: @Model.CourseTitle
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="text-secondary">
                    @Model.Description
                </p>
            }

        </div>

        <div>

            <button class="btn btn-success"
                    data-bs-toggle="modal"
                    data-bs-target="#createFlashcardModal">
                + New Flashcard
            </button>

            <a asp-action="Staging"
               asp-route-id="@Model.FlashcardSetId"
               class="btn btn-primary">
                Staging
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>

        </div>

    </div>

    <hr />

    @if (Model.Flashcards.Any())
    {
        <div class="row">

            @foreach (var card in Model.Flashcards)
            {
                <div class="col-lg-6 mb-4">

                    <div class="card shadow-sm">

                        <div class="card-header fw-bold">

                            Card @card.DisplayOrder

                        </div>

                        <div class="card-body">

                            <h6 class="text-primary">
                                Question
                            </h6>

                            <p>
                                @card.FrontContent
                            </p>

                            <hr />

                            <h6 class="text-success">
                                Answer
                            </h6>

                            <p>
                                @card.BackContent
                            </p>

                        </div>

                        <div class="card-footer text-end">

                            <button class="btn btn-warning btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editFlashcardModal-@card.FlashcardId">

                                Edit

                            </button>

                            <button class="btn btn-danger btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteFlashcardModal-@card.FlashcardId">

                                Delete

                            </button>

                        </div>

                    </div>

                </div>
                <div class="modal fade"
                     id="editFlashcardModal-@card.FlashcardId"
                     tabindex="-1">

                    <div class="modal-dialog modal-lg">

                        <div class="modal-content">

                            <form asp-action="UpdateFlashcard"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="FlashcardId"
                                       value="@card.FlashcardId" />

                                <input type="hidden"
                                       name="FlashcardSetId"
                                       value="@Model.FlashcardSetId" />

                                <div class="modal-header">
                                    <h5 class="modal-title">Edit Flashcard</h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal">
                                    </button>
                                </div>

                                <div class="modal-body">

                                    <div class="mb-3">

                                        <label class="form-label">Question</label>

                                        <textarea class="form-control"
                                          name="FrontContent"
                                          rows="4">@card.FrontContent</textarea>

                                    </div>

                                    <div class="mb-3">

                                        <label class="form-label">Answer</label>

                                        <textarea class="form-control"
                                          name="BackContent"
                                          rows="6">@card.BackContent</textarea>

                                    </div>

                                    <div class="mb-3">

                                        <label class="form-label">Display Order</label>

                                        <input class="form-control"
                                               type="number"
                                               name="DisplayOrder"
                                               value="@card.DisplayOrder" />

                                    </div>

                                </div>

                                <div class="modal-footer">

                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Cancel
                                    </button>

                                    <button class="btn btn-warning">
                                        Save Changes
                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>

                </div>
                <div class="modal fade"
                     id="deleteFlashcardModal-@card.FlashcardId"
                     tabindex="-1">

                    <div class="modal-dialog">

                        <div class="modal-content">

                            <form asp-action="DeleteFlashcard"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="flashcardId"
                                       value="@card.FlashcardId" />

                                <input type="hidden"
                                       name="flashcardSetId"
                                       value="@Model.FlashcardSetId" />

                                <div class="modal-header">

                                    <h5 class="modal-title">
                                        Delete Flashcard
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal">
                                    </button>

                                </div>

                                <div class="modal-body">

                                    <p>
                                        Are you sure you want to delete this flashcard?
                                    </p>

                                    <div class="alert alert-warning mb-0">
                                        <strong>Question:</strong><br />
                                        @card.FrontContent
                                    </div>

                                </div>

                                <div class="modal-footer">

                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">

                                        Cancel

                                    </button>

                                    <button class="btn btn-danger">

                                        Delete

                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">

            No flashcards in this set.

            Click <strong>+ New Flashcard</strong> to create one.

        </div>
    }

    <div class="modal fade"
         id="createFlashcardModal"
         tabindex="-1">

        <div class="modal-dialog modal-lg">

            <div class="modal-content">

                <form asp-action="CreateFlashcard"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="FlashcardSetId"
                           value="@Model.FlashcardSetId" />

                    <div class="modal-header">

                        <h5 class="modal-title">

                            Create Flashcard

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label">

                                Question

                            </label>

                            <textarea class="form-control"
                                      name="FrontContent"
                                      rows="4"
                                      required></textarea>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">

                                Answer

                            </label>

                            <textarea class="form-control"
                                      name="BackContent"
                                      rows="6"
                                      required></textarea>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">

                                Display Order

                            </label>

                            <input class="form-control"
                                   type="number"
                                   name="DisplayOrder"
                                   value="1"
                                   min="1" />

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button class="btn btn-secondary"
                                type="button"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button class="btn btn-success">

                            Save Flashcard

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
