@model EduNexus.Models.Lesson

<h2>AI Lesson Preview</h2>

<form asp-action="Approve" method="post">
    <input type="hidden" asp-for="ModuleId" />

    <div class="mb-3">
        <label>Lesson Name</label>
        <input asp-for="LessonName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Lesson Type</label>
        <input asp-for="LessonType" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Content</label>
        <textarea asp-for="Content" class="form-control" rows="8"></textarea>
    </div>

    <div class="mb-3">
        <label>Duration</label>
        <input asp-for="Duration" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Display Order</label>
        <input asp-for="DisplayOrder" class="form-control" />
    </div>

    <button class="btn btn-success">Approve & Save Draft</button>
</form>