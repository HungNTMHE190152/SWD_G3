@model EduNexus.ViewModels.Questions.QuestionFormViewModel
@{ ViewData["Title"] = "Create Question"; }
<h2>Create Question</h2>
<form asp-action="Create" method="post" id="questionForm">
    <input type="hidden" asp-for="BankId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="QuestionContent" class="form-label"></label>
        <textarea asp-for="QuestionContent" class="form-control"></textarea>
        <span asp-validation-for="QuestionContent" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="QuestionType" class="form-label"></label>
        <select asp-for="QuestionType" class="form-select">
            <option value="Single Choice">Single Choice</option>
            <option value="Multiple Choice">Multiple Choice</option>
            <option value="True/False">True/False</option>
            <option value="Short Answer">Short Answer</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Explanation" class="form-label"></label>
        <textarea asp-for="Explanation" class="form-control"></textarea>
    </div>

    <h4>Choices</h4>
    <div id="choices-container">
        @for(int i = 0; i < Model.Choices.Count; i++) {
            <div class="choice-row border p-2 mb-2">
                <input type="hidden" name="Choices[@i].DisplayOrder" value="@(i+1)" />
                <div class="mb-2">
                    <label>Choice Content</label>
                    <input name="Choices[@i].ChoiceContent" value="@Model.Choices[i].ChoiceContent" class="form-control" required />
                </div>
                <div class="form-check">
                    <input type="checkbox" name="Choices[@i].IsCorrect" value="true" @(Model.Choices[i].IsCorrect ? "checked" : "") class="form-check-input" />
                    <input type="hidden" name="Choices[@i].IsCorrect" value="false" />
                    <label class="form-check-label">Is Correct</label>
                </div>
            </div>
        }
    </div>
    <button type="button" class="btn btn-sm btn-info mb-3" onclick="addChoice()">Add Choice</button>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" asp-route-bankId="@Model.BankId" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        let choiceIndex = @Model.Choices.Count;
        function addChoice() {
            let html = `
            <div class="choice-row border p-2 mb-2">
                <input type="hidden" name="Choices[${choiceIndex}].DisplayOrder" value="${choiceIndex+1}" />
                <div class="mb-2">
                    <label>Choice Content</label>
                    <input name="Choices[${choiceIndex}].ChoiceContent" class="form-control" required />
                </div>
                <div class="form-check">
                    <input type="checkbox" name="Choices[${choiceIndex}].IsCorrect" value="true" class="form-check-input" />
                    <input type="hidden" name="Choices[${choiceIndex}].IsCorrect" value="false" />
                    <label class="form-check-label">Is Correct</label>
                </div>
            </div>`;
            document.getElementById('choices-container').insertAdjacentHTML('beforeend', html);
            choiceIndex++;
        }
    </script>
}
