@model EduNexus.ViewModels.Quizzes.QuizTakingViewModel
@{ ViewData["Title"] = Model.QuizTitle; }
<h2>@Model.QuizTitle</h2>
<div class="alert alert-info" id="timer">Time Remaining: --:--</div>

<form asp-action="Submit" method="post" id="quizForm">
    <input type="hidden" asp-for="AttemptId" />
    
    @for(int i = 0; i < Model.Questions.Count; i++) {
        var q = Model.Questions[i];
        <div class="card mb-3">
            <div class="card-header">
                <strong>Question @(i+1):</strong> @q.QuestionContent
            </div>
            <div class="card-body">
                @if(q.QuestionType == "Single Choice" || q.QuestionType == "True/False") {
                    foreach(var choice in q.Choices) {
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="SelectedChoices[@q.QuestionId]" value="@choice.ChoiceId" id="c_@choice.ChoiceId">
                            <label class="form-check-label" for="c_@choice.ChoiceId">@choice.ChoiceContent</label>
                        </div>
                    }
                } else if(q.QuestionType == "Short Answer") {
                    <input type="text" name="TextAnswers[@q.QuestionId]" class="form-control" />
                }
            </div>
        </div>
    }
    
    <button type="submit" class="btn btn-primary" onclick="return confirm('Are you sure you want to submit?');">Submit Quiz</button>
</form>

@section Scripts {
    <script>
        // Simple timer logic
        let durationMinutes = @Model.Duration;
        let startTime = new Date('@Model.StartTime.ToString("O")').getTime();
        let endTime = startTime + durationMinutes * 60000;
        
        let timerInterval = setInterval(function() {
            let now = new Date().getTime();
            let distance = endTime - now;
            
            if (distance < 0) {
                clearInterval(timerInterval);
                document.getElementById("timer").innerHTML = "EXPIRED";
                document.getElementById("quizForm").submit();
                return;
            }
            
            let minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            let seconds = Math.floor((distance % (1000 * 60)) / 1000);
            document.getElementById("timer").innerHTML = "Time Remaining: " + minutes + "m " + seconds + "s ";
        }, 1000);
    </script>
}
