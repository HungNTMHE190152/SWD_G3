@model EduNexus.ViewModels.Quizzes.QuizTakingViewModel

@{
    ViewData["Title"] = "Quiz Taking";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">@Model.QuizTitle</h2>
        <p class="text-muted mb-0">@Model.Description</p>
    </div>

    <div class="badge bg-danger p-3 fs-6">
        Duration: @Model.Duration minutes
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<form asp-controller="QuizAttempt" asp-action="Submit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="AttemptId" value="@Model.AttemptId" />

    @for (int i = 0; i < Model.Questions.Count; i++)
    {
        var question = Model.Questions[i];

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h5 class="fw-bold">
                    Question @(i + 1)
                </h5>

                <p class="mb-3">@question.QuestionContent</p>

                <input type="hidden"
                       name="Answers[@i].QuestionId"
                       value="@question.QuestionId" />

                @foreach (var choice in question.Choices)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input"
                               type="radio"
                               name="Answers[@i].ChoiceId"
                               value="@choice.ChoiceId"
                               id="q_@(question.QuestionId)_choice_@(choice.ChoiceId)" />

                        <label class="form-check-label"
                               for="q_@(question.QuestionId)_choice_@(choice.ChoiceId)">
                            @choice.ChoiceContent
                        </label>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
            <span class="text-muted">
                Please review your answers before submitting.
            </span>

            <button type="submit" class="btn btn-success">
                Submit Quiz
            </button>
        </div>
    </div>
</form>