@model EduNexus.ViewModels.Assignment.AssignmentDetailViewModel

@{
    ViewData["Title"] = "Delete Assignment";
}

<h2>Delete Assignment</h2>

<div class="alert alert-danger">

    Are you sure you want to delete this Assignment?

</div>

<table class="table">

    <tr>
        <th>Title</th>
        <td>@Model.Title</td>
    </tr>

    <tr>
        <th>Course</th>
        <td>@Model.CourseName</td>
    </tr>

    <tr>
        <th>Module</th>
        <td>@Model.ModuleName</td>
    </tr>

    <tr>
        <th>Due Date</th>
        <td>@Model.DueDate?.ToString("dd/MM/yyyy")</td>
    </tr>

</table>

<form asp-action="Delete">

    <input type="hidden"
           asp-for="AssignmentId" />

    <button class="btn btn-danger">

        Delete

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Cancel

    </a>

</form>