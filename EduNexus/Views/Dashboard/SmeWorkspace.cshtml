@{
    ViewData["Title"] = "SME Workspace";
}

<div class="mb-4">
    <h2 class="fw-bold">SME Workspace</h2>
    <p class="text-muted">Manage courses, lessons, assignments, flashcards, questions, and quizzes.</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="fw-bold">Course Management</h5>
                <p class="text-muted">Create and manage course structures, modules, and lessons.</p>
                <a asp-controller="Course" asp-action="Index" class="btn btn-primary btn-sm">
                    Open Courses
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="fw-bold">Assignment Management</h5>
                <p class="text-muted">Create assignments, rubrics, and review submissions.</p>
                <a asp-controller="Assignment" asp-action="Index" class="btn btn-primary btn-sm">
                    Open Assignments
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="fw-bold">Flashcard Management</h5>
                <p class="text-muted">Create flashcard decks and AI-generated flashcards.</p>
                <a asp-controller="Flashcard" asp-action="Index" class="btn btn-primary btn-sm">
                    Open Flashcards
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="fw-bold">Question Bank</h5>
                <p class="text-muted">Create question banks, questions, and choices.</p>
                <a asp-controller="QuestionBank" asp-action="Index" class="btn btn-primary btn-sm">
                    Open Questions
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="fw-bold">Quiz Management</h5>
                <p class="text-muted">Create quizzes and manage quiz attempts.</p>
                <a asp-controller="Quiz" asp-action="Manage" class="btn btn-primary btn-sm">
                    Open Quizzes
                </a>
            </div>
        </div>
    </div>
</div>