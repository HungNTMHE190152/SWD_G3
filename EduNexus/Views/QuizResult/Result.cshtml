@model EduNexus.ViewModels.Quizzes.QuizResultViewModel

@{
    ViewData["Title"] = "Quiz Result";
}

<div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
        <h2 class="fw-bold">@Model.QuizTitle</h2>
        <p class="text-muted mb-4">
            @Model.CourseTitle / @Model.ModuleName
        </p>

        <div class="display-4 fw-bold mb-3">
            @Model.TotalScore / 10
        </div>

        @if (Model.IsPassed)
        {
            <span class="badge bg-success fs-6 mb-3">Passed</span>
        }
        else
        {
            <span class="badge bg-danger fs-6 mb-3">Failed</span>
        }

        <div class="row justify-content-center mt-4">
            <div class="col-md-3">
                <div class="border rounded p-3">
                    <div class="fw-bold">@Model.TotalQuestions</div>
                    <div class="text-muted small">Questions</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="border rounded p-3">
                    <div class="fw-bold text-success">@Model.CorrectAnswers</div>
                    <div class="text-muted small">Correct</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="border rounded p-3">
                    <div class="fw-bold text-danger">@Model.WrongAnswers</div>
                    <div class="text-muted small">Wrong</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2 mt-4">
            <a asp-controller="QuizReview"
               asp-action="Index"
               asp-route-id="@Model.AttemptId"
               class="btn btn-primary">
                Review Answers
            </a>

            <a asp-controller="Quiz"
               asp-action="History"
               class="btn btn-outline-secondary">
                Quiz History
            </a>

            <a asp-controller="Quiz"
               asp-action="NewQuiz"
               class="btn btn-outline-secondary">
                Back to New Quiz
            </a>
        </div>
    </div>
</div>