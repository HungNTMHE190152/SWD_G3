
@model EduNexus.ViewModels.Rubric.RubricDetailViewModel

@{
    ViewData["Title"] = "Xóa Rubric";
}

<div class="container mt-4">
    <h3>Bạn có chắc chắn muốn xóa Rubric này?</h3>
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tên Rubric</dt>
                <dd class="col-sm-9">@Model.RubricName</dd>
                <dt class="col-sm-3">Tổng trọng số</dt>
                <dd class="col-sm-9">@Model.TotalWeight %</dd>
                <dt class="col-sm-3">Mô tả</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="RubricId" />
        <button type="submit" class="btn btn-danger">Xóa Rubric</button>
        <a asp-action="Index" asp-route-assignmentId="@Model.AssignmentId" class="btn btn-secondary">Hủy</a>
    </form>
</div>