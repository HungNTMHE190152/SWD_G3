
@model List<EduNexus.ViewModels.Rubric.RubricListViewModel>

@{
    ViewData["Title"] = "Rubrics";
    long assignmentId = (long)ViewData["AssignmentId"]!;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Rubrics cho Assignment</h2>
        <a asp-controller="Assignment" asp-action="Details" asp-route-id="@assignmentId" class="btn btn-secondary">
            ← Quay lại Assignment
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Assignment này chưa có Rubric.
            <a asp-action="Create" asp-route-assignmentId="@assignmentId" class="btn btn-primary mt-2">Tạo Rubric mới</a>
        </div>
    }
    else
    {
        @foreach (var rubric in Model)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5>@rubric.RubricName</h5>
                </div>
                <div class="card-body">
                    <p><strong>Tổng trọng số:</strong> @rubric.TotalWeight%</p>
                    <p><strong>Mô tả:</strong> @rubric.Description</p>
                    
                </div>
                <div class="card-footer">
                    <a asp-action="Details" asp-route-id="@rubric.RubricId" class="btn btn-info">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@rubric.RubricId" class="btn btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@rubric.RubricId" class="btn btn-danger">Xóa</a>
                    <a asp-controller="RubricCriterion" asp-action="Index" asp-route-rubricId="@rubric.RubricId"
                       class="btn btn-primary btn-sm">Manage Criteria</a>
                </div>
                
            </div>
        }
    }
</div>