@model List<EduNexus.Models.Course>

<h2>Course List</h2>

<table class="table">
    <thead>
        <tr>
            <th>Code</th>
            <th>Title</th>
            <th>Status</th>
            <th>Price</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.CourseCode</td>
                <td>@course.Title</td>
                <td>@course.Status</td>
                <td>@course.Price</td>
                <td>
                    <a class="btn btn-sm btn-primary"
                       asp-controller="Course"
                       asp-action="Structure"
                       asp-route-id="@course.CourseId">
                        Structure
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>