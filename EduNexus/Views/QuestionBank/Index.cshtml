@model List<EduNexus.ViewModels.Questions.QuestionBankListItemViewModel>

@{
    ViewData["Title"] = "Question Bank";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Question Bank</h2>
        <p class="text-muted mb-0">Manage question banks by course.</p>
    </div>

    <a asp-controller="QuestionBank" asp-action="Create" class="btn btn-primary">
        Create Question Bank
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <h5>No question bank yet</h5>
            <p class="text-muted">Create your first question bank to start adding questions.</p>
            <a asp-controller="QuestionBank" asp-action="Create" class="btn btn-primary">
                Create Question Bank
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Bank Name</th>
                        <th>Course</th>
                        <th>Questions</th>
                        <th>Public</th>
                        <th>Created At</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bank in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@bank.BankName</div>
                                <small class="text-muted">@bank.Description</small>
                            </td>
                            <td>@bank.CourseTitle</td>
                            <td>@bank.QuestionCount</td>
                            <td>
                                @if (bank.IsPublic)
                                {
                                    <span class="badge bg-success">Public</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Private</span>
                                }
                            </td>
                            <td>@bank.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <a asp-controller="QuestionBank"
                                   asp-action="Details"
                                   asp-route-id="@bank.BankId"
                                   class="btn btn-sm btn-outline-primary">
                                    Open
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}