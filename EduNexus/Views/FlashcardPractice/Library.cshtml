@model EduNexus.ViewModels.Flashcards.FlashcardLibraryViewModel

@{
    ViewData["Title"] = "Flashcard Library";
}

<style>

    .library-title {
        font-weight: 700;
        font-size: 2rem;
    }

    .library-subtitle {
        color: #6c757d;
        margin-bottom: 30px;
    }

    .stat-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 .125rem .75rem rgba(0,0,0,.08);
        transition: .25s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

    .search-panel {
        border: none;
        border-radius: 16px;
        box-shadow: 0 .125rem .75rem rgba(0,0,0,.08);
    }

        .search-panel .form-control,
        .search-panel .form-select {
            height: 46px;
        }

    .library-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 .15rem .75rem rgba(0,0,0,.08);
        transition: .25s;
    }

        .library-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15);
        }

        .library-card .card-body {
            min-height: 200px;
        }

    .badge-course {
        display: inline-block;
        background: #eef4ff;
        color: #0d6efd;
        font-weight: 600;
        border-radius: 20px;
        padding: 6px 12px;
    }

    .description {
        min-height: 70px;
        color: #6c757d;
    }

    .empty-state {
        text-align: center;
        padding: 80px;
        color: #999;
    }
</style>

<div class="container py-4">

    <div class="mb-4">

        <h2 class="library-title">

            📚 Flashcard Library

        </h2>

        <p class="library-subtitle">

            Browse available flashcard sets.

        </p>

    </div>

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card stat-card">

                <div class="card-body text-center">

                    <h6 class="text-muted">

                        Total Sets

                    </h6>

                    <h2>

                        @Model.TotalSets

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card stat-card">

                <div class="card-body text-center">

                    <h6 class="text-muted">

                        Total Flashcards

                    </h6>

                    <h2>

                        @Model.TotalFlashcards

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card stat-card">

                <div class="card-body text-center">

                    <h6 class="text-muted">

                        Courses

                    </h6>

                    <h2>

                        @Model.TotalCourses

                    </h2>

                </div>

            </div>

        </div>

    </div>

    <div class="card search-panel mb-4">

        <div class="card-body">

            <form asp-action="Library"
                  method="get">

                <div class="row g-2">

                    <div class="col-md-4">

                        <input asp-for="Keyword"
                               class="form-control"
                               placeholder="Search flashcard sets..." />

                    </div>

                    <div class="col-md-3">

                        <select asp-for="CourseId"
                                class="form-select">

                            <option value="">

                                All Courses

                            </option>

                            @foreach (var course in Model.Courses)
                            {
                                <option value="@course.CourseId">

                                    @course.CourseTitle

                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-3">

                        <select asp-for="SortBy"
                                class="form-select">

                            <option value="newest">

                                Newest

                            </option>

                            <option value="oldest">

                                Oldest

                            </option>

                            <option value="name">

                                A - Z

                            </option>

                            <option value="cards">

                                Most Cards

                            </option>

                        </select>

                    </div>

                    <div class="col-md-2">

                        <button class="btn btn-primary w-100 h-100">

                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>
    @if (!Model.FlashcardSets.Any())
    {
        <div class="card library-card">

            <div class="empty-state">

                <h2>📚</h2>

                <h4 class="mt-3">

                    No Flashcard Sets Found

                </h4>

                <p>

                    There are currently no flashcard sets available.

                </p>

            </div>

        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model.FlashcardSets)
            {
                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="card library-card h-100">

                        <div class="card-body d-flex flex-column">

                            <h5 class="fw-bold mb-3">

                                @item.SetName

                            </h5>

                            <div class="mb-3">

                                <span class="badge-course">

                                    @item.CourseTitle

                                </span>

                            </div>

                            <p class="description flex-grow-1">

                                @(string.IsNullOrWhiteSpace(item.Description)
                                                        ? "No description available."
                                                        : item.Description)

                    </p>

                        </div>

                        <div class="card-footer bg-white border-0">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <span class="badge bg-primary fs-6">

            @item.TotalCards Cards

        </span>

        <small class="text-muted">

            @item.CreatedAt?.ToString("dd/MM/yyyy")

        </small>

    </div>

    @if (item.HasPracticed)
    {
        <div class="row g-3 text-center mb-3">

            <div class="col-4">

                <small class="text-muted d-block">
                    Accuracy
                </small>

                <div class="fw-bold fs-5 text-success">

                    @item.Accuracy%

                </div>

            </div>

            <div class="col-4">

                <small class="text-muted d-block">
                    Reviews
                </small>

                <div class="fw-bold fs-5">

                    @item.TotalReviews

                </div>

            </div>

            <div class="col-4">

                <small class="text-muted d-block">
                    Status
                </small>

                <span class="badge bg-success px-3 py-2">

                    In Progress

                </span>

            </div>

        </div>

        <div class="bg-light rounded-3 p-3 mb-3">

            <small class="text-muted d-block mb-1">

                Last Practice

            </small>

            <strong>

                @item.LastReviewed?.ToString("dd/MM/yyyy")

            </strong>

        </div>
    }
    else
    {
        <div class="text-center mb-3">

            <span class="badge bg-secondary px-3 py-2">

                Not Started

            </span>

        </div>
    }

    <a asp-action="Study"
       asp-route-id="@item.FlashcardSetId"
       class="btn btn-primary w-100">

        @(item.HasPracticed ? "Study Again" : "Study Now")

    </a>

</div>

                    </div>

                </div>
                }

        </div>
    }

</div>