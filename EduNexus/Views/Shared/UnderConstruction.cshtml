@{
    string title = ViewData["Title"]?.ToString() ?? "Under Construction";
    string message = ViewData["Message"]?.ToString() ?? "This feature is being developed.";
}

<div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
        <h2 class="fw-bold">@title</h2>
        <p class="text-muted mb-4">@message</p>

        <a asp-controller="Dashboard" asp-action="SmeWorkspace" class="btn btn-primary">
            Back to Workspace
        </a>
    </div>
</div>