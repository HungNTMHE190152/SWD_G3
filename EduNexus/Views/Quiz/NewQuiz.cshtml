@model EduNexus.ViewModels.Quizzes.NewQuizViewModel

@{
    ViewData["Title"] = "New Quiz";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">New Quiz</h2>
        <p class="text-muted mb-0">Start a quiz from your enrolled courses.</p>
    </div>

    <a asp-controller="Quiz" asp-action="History" class="btn btn-outline-secondary">
        Quiz History
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.Quizzes.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <h5>No quiz available</h5>
            <p class="text-muted mb-0">
                There are no quizzes for your enrolled courses yet.
            </p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var quiz in Model.Quizzes)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="fw-bold">@quiz.QuizTitle</h5>
                        <p class="text-muted">@quiz.Description</p>

                        <div class="mb-2">
                            <span class="badge bg-primary">@quiz.CourseTitle</span>
                            <span class="badge bg-secondary">@quiz.ModuleName</span>
                        </div>

                        <div class="small text-muted mb-3">
                            Duration: @quiz.Duration minutes |
                            Questions: @quiz.QuestionCount |
                            Passing: @quiz.PassingScore
                        </div>

                        @if (quiz.AttemptCount > 0)
                        {
                            <div class="alert alert-light border small">
                                Attempts: @quiz.AttemptCount
                                @if (quiz.LastScore != null)
                                {
                                    <span> | Last score: @quiz.LastScore</span>
                                }
                            </div>
                        }

                        <form asp-controller="QuizAttempt" asp-action="Start" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="quizId" value="@quiz.QuizId" />

                            <button type="submit" class="btn btn-primary">
                                Start Quiz
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}