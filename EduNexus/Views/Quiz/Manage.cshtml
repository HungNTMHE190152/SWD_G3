@model IEnumerable<EduNexus.ViewModels.Quizzes.QuizListViewModel>
@{ ViewData["Title"] = "Quiz Management"; }
<h2>Quiz Management</h2>
<a asp-action="Create" asp-route-assignmentId="@ViewBag.AssignmentId" class="btn btn-primary mb-3">Create New Quiz</a>
<table class="table">
    <thead><tr><th>Title</th><th>Duration</th><th>Passing Score</th><th>Questions</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach(var item in Model) {
        <tr>
            <td>@item.QuizTitle</td>
            <td>@item.Duration min</td>
            <td>@item.PassingScore</td>
            <td>@item.QuestionCount</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.QuizId" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="SelectQuestions" asp-route-quizId="@item.QuizId" class="btn btn-sm btn-info">Add Questions</a>
            </td>
        </tr>
    }
    </tbody>
</table>
