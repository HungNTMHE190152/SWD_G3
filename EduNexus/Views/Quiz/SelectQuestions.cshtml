@model EduNexus.ViewModels.Quizzes.QuizQuestionSelectionViewModel
@{ ViewData["Title"] = "Select Questions for Quiz"; }
<h2>Select Questions for Quiz</h2>
<form asp-action="AddQuestions" method="post">
    <input type="hidden" asp-for="QuizId" />
    <input type="hidden" asp-for="BankId" />
    
    <div class="mb-3">
        <label class="form-label">Select Bank to filter (Demo assumes Bank 1)</label>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Select</th>
                <th>Question</th>
                <th>Type</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var q in Model.AvailableQuestions) {
                <tr>
                    <td>
                        @if(!q.IsAlreadyInQuiz) {
                            <input type="checkbox" name="SelectedQuestionIds" value="@q.QuestionId" />
                        }
                    </td>
                    <td>@q.QuestionContent</td>
                    <td>@q.QuestionType</td>
                    <td>
                        @if(q.IsAlreadyInQuiz) {
                            <span class="badge bg-success">Added</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
    <button type="submit" class="btn btn-primary">Add Selected to Quiz</button>
    <a asp-action="Manage" class="btn btn-secondary">Back to Quizzes</a>
</form>
