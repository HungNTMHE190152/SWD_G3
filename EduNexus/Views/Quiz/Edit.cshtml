@model EduNexus.ViewModels.Quizzes.QuizFormViewModel
@{ ViewData["Title"] = "Edit Quiz"; }
<h2>Edit Quiz</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="QuizId" />
    <input type="hidden" asp-for="AssignmentId" />
    <div class="mb-3">
        <label asp-for="QuizTitle" class="form-label"></label>
        <input asp-for="QuizTitle" class="form-control" />
        <span asp-validation-for="QuizTitle" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Duration" class="form-label"></label>
        <input asp-for="Duration" class="form-control" type="number" />
        <span asp-validation-for="Duration" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PassingScore" class="form-label"></label>
        <input asp-for="PassingScore" class="form-control" type="number" step="0.01" />
    </div>
    <div class="mb-3 form-check">
        <input asp-for="ShuffleQuestion" class="form-check-input" />
        <label asp-for="ShuffleQuestion" class="form-check-label"></label>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="ShuffleAnswer" class="form-check-input" />
        <label asp-for="ShuffleAnswer" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Manage" asp-route-assignmentId="@Model.AssignmentId" class="btn btn-secondary">Cancel</a>
</form>
