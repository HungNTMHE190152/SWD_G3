@model List<EduNexus.ViewModels.Submission.SubmissionListViewModel>

@{
    ViewData["Title"] = "Danh sách Bài Nộp";
    long assignmentId = (long)ViewData["AssignmentId"]!;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Danh sách Bài Nộp</h3>
        <a asp-action="Index" class="btn btn-secondary">← Quay lại Assignments</a>
    </div>

    <table class="table table-hover table-bordered">
        <thead class="table-light">
            <tr>
                <th>Sinh viên</th>
                <th>Nộp lúc</th>
                <th>Điểm</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.StudentName</td>
                    <td>@item.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (item.TotalScore.HasValue)
                        {
                            <strong>@item.TotalScore</strong>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        @if (item.IsPublished)
                        {
                            <span class="badge bg-success">Đã công bố</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Chưa chấm</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Grade" asp-route-submissionId="@item.SubmissionId"
                           class="btn btn-primary btn-sm">Chấm bài</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>