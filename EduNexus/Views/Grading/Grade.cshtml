@model EduNexus.ViewModels.Grading.GradeSubmissionViewModel

@{
    ViewData["Title"] = "Chấm bài - " + Model.StudentName;
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4>Chấm bài theo Rubric</h4>
            <h5>@Model.AssignmentTitle — @Model.StudentName</h5>
        </div>
        <div class="card-body">
            <form asp-action="Grade" method="post">
                <input type="hidden" asp-for="SubmissionId" />
                <input type="hidden" asp-for="AssignmentId" />

                @if (!string.IsNullOrEmpty(Model.SubmissionText))
                {
                    <div class="mb-4">
                        <h5>Nội dung bài nộp</h5>
                        <div class="border p-3 bg-light" style="max-height: 300px; overflow-y: auto; white-space: pre-wrap;">
                            @Model.SubmissionText
                        </div>
                    </div>
                }

                <!-- Nút AI Grading -->
                <div class="mb-3">
                    <button type="button" id="btnAIGrade" class="btn btn-info">
                        🤖 Generate AI Grade
                    </button>
                </div>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Tiêu chí</th>
                            <th>Trọng số</th>
                            <th>Max Score</th>
                            <th>Điểm chấm</th>
                            <th>Nhận xét</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Criteria.Count; i++)
                        {
                            var c = Model.Criteria[i];
                            <tr>
                                <td>
                                    <input type="hidden" name="Criteria[@i].CriterionId" value="@c.CriterionId" />
                                    <strong>@c.CriterionName</strong>
                                </td>
                                <td>@c.Weight %</td>
                                <td>@c.MaxScore</td>
                                <td>
                                    <input type="number" step="0.01"
                                           name="Criteria[@i].Score"
                                           value="@c.Score"
                                           class="form-control score-input"
                                           style="width: 130px;"
                                           min="0" max="@c.MaxScore" />
                                </td>
                                <td>
                                    <textarea name="Criteria[@i].Comment"
                                              class="form-control"
                                              rows="2">@c.Comment</textarea>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success">💾 Lưu Điểm</button>
                    <a asp-action="Submissions" asp-route-assignmentId="@Model.AssignmentId"
                       class="btn btn-secondary">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnAIGrade').addEventListener('click', async function () {
            if (!confirm('Sử dụng AI để chấm tự động?\nKết quả sẽ được điền vào form, bạn vẫn có thể chỉnh sửa.')) {
                return;
            }

            const submissionIdInput = document.querySelector('input[name="SubmissionId"]');
            if (!submissionIdInput) {
                alert("Không tìm thấy SubmissionId!");
                return;
            }

            const submissionId = parseInt(submissionIdInput.value);

            try {
                const response = await fetch('/Grading/GenerateAI', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ submissionId: submissionId })
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error('HTTP ' + response.status + ': ' + errorText);
                }

                const data = await response.json();

                // Điền dữ liệu từ AI vào form
                if (data.criteria && Array.isArray(data.criteria)) {
                    data.criteria.forEach((c, index) => {
                        const scoreInput = document.querySelector(`input[name="Criteria[${index}].Score"]`);
                        const commentInput = document.querySelector(`textarea[name="Criteria[${index}].Comment"]`);

                        if (scoreInput) scoreInput.value = c.score || 0;
                        if (commentInput) commentInput.value = c.comment || '';
                    });
                    alert('✅ AI đã chấm xong! Bạn có thể chỉnh sửa trước khi lưu.');
                } else {
                    alert('AI trả về dữ liệu không hợp lệ.');
                }
            } catch (e) {
                console.error(e);
                alert('Lỗi khi gọi AI: ' + e.message);
            }
        });
    </script>
}