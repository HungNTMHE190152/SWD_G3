@model EduNexus.ViewModels.Assignment.ClassroomAssignmentViewModel

@{
    ViewData["Title"] = "Assignment Details";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title mb-1">
                Assignment Details
            </h2>

            <p class="text-muted mb-0">
                View published assignment information.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>

            Back

        </a>

    </div>

    <div class="row">

        <!-- Left -->
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h5 class="mb-4">

                        <i class="bi bi-journal-text me-2 text-primary"></i>

                        Assignment Information

                    </h5>

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label class="detail-label">
                                Assignment Title
                            </label>

                            <div class="detail-box">
                                @Model.Title
                            </div>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label class="detail-label">
                                Classroom
                            </label>

                            <div class="detail-box">
                                @Model.ClassroomName
                            </div>

                        </div>

                    </div>

                    <div class="mb-4">

                        <label class="detail-label">
                            Assignment Template
                        </label>

                        <div class="detail-box">
                            @Model.AssignmentTemplateName
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label class="detail-label">
                                Open Date
                            </label>

                            <div class="detail-box">
                                @Model.OpenDate.ToString("dd/MM/yyyy HH:mm")
                            </div>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label class="detail-label">
                                Due Date
                            </label>

                            <div class="detail-box">
                                @Model.DueDate.ToString("dd/MM/yyyy HH:mm")
                            </div>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label class="detail-label">
                                Status
                            </label>

                            <div class="detail-box">

                                @if (Model.Status == "Published")
                                {
                                    <span class="badge bg-success">

                                        <i class="bi bi-check-circle-fill me-1"></i>

                                        Published

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @Model.Status
                                    </span>
                                }

                            </div>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label class="detail-label">
                                Late Submission
                            </label>

                            <div class="detail-box">

                                @if (Model.AllowLateSubmission)
                                {
                                    <span class="badge bg-success">

                                        <i class="bi bi-check-circle-fill me-1"></i>

                                        Allowed

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">

                                        <i class="bi bi-x-circle-fill me-1"></i>

                                        Not Allowed

                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Right -->
        <div class="col-lg-4">

            <!-- Summary -->
            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body">

                    <h5>

                        <i class="bi bi-clipboard-data me-2 text-primary"></i>

                        Summary

                    </h5>

                    <hr />

                    <table class="table table-borderless mb-0">

                        <tr>

                            <td class="text-muted">
                                Classroom
                            </td>

                            <td class="text-end fw-semibold">
                                @Model.ClassroomName
                            </td>

                        </tr>

                        <tr>

                            <td class="text-muted">
                                Status
                            </td>

                            <td class="text-end">

                                @if (Model.Status == "Published")
                                {
                                    <span class="badge bg-success">
                                        Published
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @Model.Status
                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <td class="text-muted">
                                Late Submission
                            </td>

                            <td class="text-end">

                                @if (Model.AllowLateSubmission)
                                {
                                    <span class="badge bg-success">
                                        Allowed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Disabled
                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <td class="text-muted">
                                Duration
                            </td>

                            <td class="text-end">

                                @((Model.DueDate - Model.OpenDate).Days)
                                days

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

            <!-- Action -->
            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <a asp-action="Edit"
                       asp-route-id="@Model.ClassroomAssignmentId"
                       class="btn btn-primary w-100 mb-2">

                        <i class="bi bi-pencil-square me-2"></i>

                        Edit Assignment

                    </a>

                    <a asp-area="Teacher"
                       asp-controller="AssignmentSubmission"
                       asp-action="Index"
                       asp-route-classroomAssignmentId="@Model.ClassroomAssignmentId"
                       class="btn btn-outline-success w-100 mb-2">

                        <i class="bi bi-file-earmark-text me-2"></i>

                        View Submissions

                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary w-100">

                        Back to List

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>