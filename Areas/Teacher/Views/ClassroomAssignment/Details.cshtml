@model EduNexus.ViewModels.Assignment.ClassroomAssignmentViewModel

@{
    ViewData["Title"] = "Assignment Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Assignment Details</h2>
            <p class="text-muted mb-0">
                View published assignment information.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to List

        </a>

    </div>

    <div class="card shadow border-0">

        <div class="card-header bg-info text-white">

            <h5 class="mb-0">

                <i class="bi bi-info-circle me-2"></i>
                Assignment Information

            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-4">

                    <label class="form-label text-muted">
                        Assignment Title
                    </label>

                    <div class="form-control bg-light">
                        @Model.Title
                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <label class="form-label text-muted">
                        Classroom
                    </label>

                    <div class="form-control bg-light">
                        @Model.ClassroomName
                    </div>

                </div>

            </div>

            <div class="mb-4">

                <label class="form-label text-muted">
                    Assignment Template
                </label>

                <div class="form-control bg-light">
                    @Model.AssignmentTemplateName
                </div>

            </div>

            <div class="row">

                <div class="col-md-6 mb-4">

                    <label class="form-label text-muted">
                        Open Date
                    </label>

                    <div class="form-control bg-light">
                        @Model.OpenDate.ToString("dd/MM/yyyy HH:mm")
                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <label class="form-label text-muted">
                        Due Date
                    </label>

                    <div class="form-control bg-light">
                        @Model.DueDate.ToString("dd/MM/yyyy HH:mm")
                    </div>

                </div>

            </div>

            <div class="row">

                <div class="col-md-6 mb-4">

                    <label class="form-label text-muted">
                        Status
                    </label>

                    <div>

                        @if (Model.Status == "Published")
                        {
                            <span class="badge bg-success fs-6">
                                <i class="bi bi-check-circle-fill me-1"></i>
                                Published
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">
                                @Model.Status
                            </span>
                        }

                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <label class="form-label text-muted">
                        Late Submission
                    </label>

                    <div>

                        @if (Model.AllowLateSubmission)
                        {
                            <span class="badge bg-success fs-6">
                                <i class="bi bi-check-circle-fill me-1"></i>
                                Allowed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">
                                <i class="bi bi-x-circle-fill me-1"></i>
                                Not Allowed
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

        <div class="card-footer bg-white">

            <div class="d-flex justify-content-end">

                <a asp-action="Edit"
                   asp-route-id="@Model.ClassroomAssignmentId"
                   class="btn btn-warning me-2">

                    <i class="bi bi-pencil-square me-1"></i>
                    Edit

                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back

                </a>

            </div>

        </div>

    </div>

</div>