@model EduNexus.ViewModels.Assignment.ClassroomAssignmentViewModel

@{
    ViewData["Title"] = "Edit Published Assignment";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Edit Published Assignment</h2>
            <p class="text-muted mb-0">
                Update the published assignment information.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to List

        </a>

    </div>

    <div class="card shadow border-0">

        <div class="card-header bg-warning">

            <h5 class="mb-0">

                <i class="bi bi-pencil-square me-2"></i>
                Assignment Information

            </h5>

        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input asp-for="ClassroomAssignmentId" type="hidden" />
                <input asp-for="Status" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="ClassroomId"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="ClassroomId"
                                asp-items="Model.Classrooms"
                                class="form-select">
                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="AssignmentTemplateId"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="AssignmentTemplateId"
                                asp-items="Model.Assignments"
                                class="form-select">
                        </select>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter assignment title" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="OpenDate"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="OpenDate"
                               type="datetime-local"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="DueDate"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="DueDate"
                               type="datetime-local"
                               class="form-control" />

                    </div>

                </div>

                <div class="form-check form-switch mb-4">

                    <input asp-for="AllowLateSubmission"
                           class="form-check-input" />

                    <label asp-for="AllowLateSubmission"
                           class="form-check-label fw-semibold">

                        Allow Late Submission

                    </label>

                </div>

                <hr />

                <div class="d-flex justify-content-end">

                    <a asp-action="Index"
                       class="btn btn-secondary me-2">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-warning">

                        <i class="bi bi-check-circle me-1"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}