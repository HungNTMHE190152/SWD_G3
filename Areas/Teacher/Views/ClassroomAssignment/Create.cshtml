@model EduNexus.ViewModels.Assignment.ClassroomAssignmentViewModel

@{
    ViewData["Title"] = "Publish Assignment";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title mb-1">
                Publish Assignment
            </h2>

            <p class="text-muted mb-0">
                Publish an assignment to a classroom.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>

            Back

        </a>

    </div>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="row">

            <!-- Left -->

            <div class="col-lg-8">

                <!-- Assignment Information -->

                <div class="card shadow-sm border-0 mb-4">

                    <div class="card-body p-4">

                        <h5 class="mb-4">

                            <i class="bi bi-journal-plus me-2 text-primary"></i>

                            Assignment Information

                        </h5>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Title"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="Enter assignment title" />

                                <span asp-validation-for="Title"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="ClassroomId"
                                       class="form-label fw-semibold">

                                    Classroom

                                </label>

                                <select asp-for="ClassroomId"
                                        class="form-select"
                                        asp-items="Model.Classrooms">

                                    <option value="">
                                        -- Select Classroom --
                                    </option>

                                </select>

                                <span asp-validation-for="ClassroomId"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="AssignmentTemplateId"
                                   class="form-label fw-semibold">

                                Assignment Template

                            </label>

                            <select asp-for="AssignmentTemplateId"
                                    class="form-select"
                                    asp-items="Model.Assignments">

                                <option value="">
                                    -- Select Template --
                                </option>

                            </select>

                            <span asp-validation-for="AssignmentTemplateId"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

                <!-- Schedule -->

                <div class="card shadow-sm border-0 mb-4">

                    <div class="card-body p-4">

                        <h5 class="mb-4">

                            <i class="bi bi-calendar-event me-2 text-primary"></i>

                            Schedule

                        </h5>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="OpenDate"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="OpenDate"
                                       type="datetime-local"
                                       class="form-control" />

                                <span asp-validation-for="OpenDate"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="DueDate"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="DueDate"
                                       type="datetime-local"
                                       class="form-control" />

                                <span asp-validation-for="DueDate"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Settings -->

                <div class="card shadow-sm border-0">

                    <div class="card-body p-4">

                        <h5 class="mb-4">

                            <i class="bi bi-sliders me-2 text-primary"></i>

                            Submission Settings

                        </h5>

                        <div class="form-check form-switch">

                            <input asp-for="AllowLateSubmission"
                                   class="form-check-input" />

                            <label asp-for="AllowLateSubmission"
                                   class="form-check-label fw-semibold">

                                Allow Late Submission

                            </label>

                        </div>

                        <small class="text-muted">

                            Students can submit after the due date if enabled.

                        </small>

                    </div>

                </div>

            </div>

            <!-- Right -->

            <div class="col-lg-4">

                <div class="card shadow-sm border-0 mb-4">

                    <div class="card-body">

                        <h5>

                            <i class="bi bi-lightbulb me-2 text-warning"></i>

                            Publishing Tips

                        </h5>

                        <hr />

                        <ul class="small text-muted mb-0">

                            <li>Select the correct classroom.</li>

                            <li>Choose the appropriate assignment template.</li>

                            <li>Open Date should be earlier than Due Date.</li>

                            <li>Enable Late Submission only when necessary.</li>

                            <li>Students will see the assignment after the Open Date.</li>

                        </ul>

                    </div>

                </div>

                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <button type="submit"
                                class="btn btn-primary w-100 mb-2">

                            <i class="bi bi-upload me-2"></i>

                            Publish Assignment

                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary w-100">

                            Cancel

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}