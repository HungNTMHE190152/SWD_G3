@model IEnumerable<EduNexus.ViewModels.Assignment.ClassroomAssignmentViewModel>

@{
    ViewData["Title"] = "Published Assignments";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Published Assignments</h2>
            <p class="text-muted mb-0">
                Manage all assignments that have been published to classrooms.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Publish Assignment
        </a>

    </div>

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card shadow border-0">

                <div class="card-body">

                    <h6 class="text-muted">Total Assignments</h6>

                    <h2 class="fw-bold text-primary">
                        @Model.Count()
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0">

                <div class="card-body">

                    <h6 class="text-muted">Published</h6>

                    <h2 class="fw-bold text-success">
                        @Model.Count(x => x.Status == "Published")
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow border-0">

                <div class="card-body">

                    <h6 class="text-muted">Late Submission Allowed</h6>

                    <h2 class="fw-bold text-warning">
                        @Model.Count(x => x.AllowLateSubmission)
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                <i class="bi bi-journal-text me-2"></i>
                Assignment List

            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Title</th>
                            <th>Classroom</th>
                            <th>Template</th>
                            <th>Open Date</th>
                            <th>Due Date</th>
                            <th>Late</th>
                            <th>Status</th>
                            <th class="text-center" width="220">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @item.Title
                                    </td>

                                    <td>
                                        @item.ClassroomName
                                    </td>

                                    <td>
                                        @item.AssignmentTemplateName
                                    </td>

                                    <td>
                                        @item.OpenDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @item.DueDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>

                                        @if (item.AllowLateSubmission)
                                        {
                                            <span class="badge bg-success">
                                                Allowed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Not Allowed
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (item.Status == "Published")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Details"
                                           asp-route-id="@item.ClassroomAssignmentId"
                                           class="btn btn-info btn-sm">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.ClassroomAssignmentId"
                                           class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a asp-area="Teacher"
                                           asp-controller="AssignmentSubmission"
                                           asp-action="Index"
                                           asp-route-classroomAssignmentId="@item.ClassroomAssignmentId"
                                           class="btn btn-success btn-sm"
                                           title="View Submissions">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@item.ClassroomAssignmentId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Delete this assignment?')">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8" class="text-center py-5">

                                    <i class="bi bi-inbox display-5 text-muted"></i>

                                    <div class="mt-3">

                                        <h5>No published assignments</h5>

                                        <p class="text-muted">
                                            Click "Publish Assignment" to create your first assignment.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>