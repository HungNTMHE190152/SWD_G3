@model EduNexus.ViewModels.Assignment.ClassroomViewModel

@{
    ViewData["Title"] = "Edit Classroom";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title mb-1">
                Edit Classroom
            </h2>

            <p class="text-muted mb-0">
                Update classroom information and schedule.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>

            Back

        </a>

    </div>

    <form asp-action="Edit" method="post">

        <input asp-for="ClassroomId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="row">

            <!-- Main Form -->
            <div class="col-lg-8">

                <!-- Classroom Information -->
                <div class="card shadow-sm border-0 mb-4">

                    <div class="card-body p-4">

                        <h5 class="mb-4">

                            <i class="bi bi-pencil-square me-2 text-primary"></i>

                            Classroom Information

                        </h5>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="CourseId"
                                       class="form-label fw-semibold">
                                    Course
                                </label>

                                <select asp-for="CourseId"
                                        class="form-select">

                                    @foreach (var course in Model.Courses)
                                    {
                                        <option value="@course.CourseId">
                                            @course.CourseCode - @course.CourseTitle
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="CourseId"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="EnrollmentCode"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="EnrollmentCode"
                                       class="form-control"
                                       placeholder="Example: SE1908-SP25" />

                                <span asp-validation-for="EnrollmentCode"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="ClassName"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="ClassName"
                                   class="form-control"
                                   placeholder="Enter classroom name" />

                            <span asp-validation-for="ClassName"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

                <!-- Schedule -->
                <div class="card shadow-sm border-0 mb-4">

                    <div class="card-body p-4">

                        <h5 class="mb-4">

                            <i class="bi bi-calendar-event me-2 text-primary"></i>

                            Schedule

                        </h5>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="StartDate"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="StartDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="StartDate"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="EndDate"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="EndDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="EndDate"
                                      class="text-danger"></span>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Status -->
                <div class="card shadow-sm border-0">

                    <div class="card-body p-4">

                        <h5 class="mb-4">

                            <i class="bi bi-toggle-on me-2 text-primary"></i>

                            Classroom Status

                        </h5>

                        <div class="row">

                            <div class="col-md-6">

                                <label asp-for="Status"
                                       class="form-label fw-semibold">
                                </label>

                                <select asp-for="Status"
                                        class="form-select">

                                    <option value="OPEN">OPEN</option>
                                    <option value="CLOSED">CLOSED</option>

                                </select>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Right Panel -->
            <div class="col-lg-4">

                <div class="card shadow-sm border-0 mb-4">

                    <div class="card-body">

                        <h5>

                            <i class="bi bi-info-circle me-2 text-primary"></i>

                            Information

                        </h5>

                        <hr />

                        <ul class="small text-muted mb-0">

                            <li>
                                Updating the classroom will immediately affect enrolled students.
                            </li>

                            <li>
                                Keep the Enrollment Code unchanged if students are already using it.
                            </li>

                            <li>
                                Closing a classroom prevents new enrollments.
                            </li>

                            <li>
                                Make sure the schedule remains valid.
                            </li>

                        </ul>

                    </div>

                </div>

                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <button type="submit"
                                class="btn btn-primary w-100 mb-2">

                            <i class="bi bi-save me-2"></i>

                            Update Classroom

                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary w-100">

                            Cancel

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}