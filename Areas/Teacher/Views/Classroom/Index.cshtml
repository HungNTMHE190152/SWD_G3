@model IEnumerable<EduNexus.ViewModels.Assignment.ClassroomViewModel>

@{
    ViewData["Title"] = "Classroom Management";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Classroom Management</h2>
            <p class="text-muted mb-0">
                Manage all of your classrooms here.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Create Classroom
        </a>

    </div>

    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card shadow border-0">
                <div class="card-body">
                    <h6>Total Classrooms</h6>
                    <h2>@Model.Count()</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow border-0">
                <div class="card-body">
                    <h6>Open Classrooms</h6>
                    <h2>@Model.Count(x => x.Status == "OPEN")</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow border-0">
                <div class="card-body">
                    <h6>Closed Classrooms</h6>
                    <h2>@Model.Count(x => x.Status != "OPEN")</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow border-0">

        <div class="card-body">

            <table class="table table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Course</th>
                        <th>Classroom</th>
                        <th>Enrollment Code</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th width="200">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.CourseName</td>

                                <td>
                                    <strong>@item.ClassName</strong>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark">
                                        @item.EnrollmentCode
                                    </span>
                                </td>

                                <td>
                                    @item.StartDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @item.EndDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    @if (item.Status == "OPEN")
                                    {
                                        <span class="badge bg-success">
                                            OPEN
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.ClassroomId"
                                       class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.ClassroomId"
                                       class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <!-- Nút Students -->
                                    <a asp-area="Teacher"
                                       asp-controller="Enrollment"
                                       asp-action="Index"
                                       asp-route-classroomId="@item.ClassroomId"
                                       class="btn btn-sm btn-success"
                                       title="View Students">
                                        <i class="bi bi-people-fill"></i>
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.ClassroomId"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button class="btn btn-sm btn-danger"
                                                onclick="return confirm('Delete this classroom?')">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7" class="text-center py-5">

                                <h5>No classrooms found.</h5>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>