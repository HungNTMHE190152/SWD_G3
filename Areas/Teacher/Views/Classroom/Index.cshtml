@model IEnumerable<EduNexus.ViewModels.Assignment.ClassroomViewModel>

@{
    ViewData["Title"] = "Classroom Management";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title mb-1">
                Classroom Management
            </h2>

            <p class="text-muted mb-0">
                Create, organize and manage your classrooms.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-2"></i>

            Create Classroom

        </a>

    </div>

    <!-- Statistics -->
    <div class="row mb-4">

        <div class="col-lg-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Total Classrooms
                    </small>

                    <h2 class="fw-bold mt-2">
                        @Model.Count()
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Open Classrooms
                    </small>

                    <h2 class="fw-bold text-success mt-2">
                        @Model.Count(x => x.Status == "OPEN")
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Closed Classrooms
                    </small>

                    <h2 class="fw-bold text-secondary mt-2">
                        @Model.Count(x => x.Status != "OPEN")
                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- Table -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white border-0">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    Classroom List

                </h5>

                <span class="badge bg-primary">

                    @Model.Count() Classrooms

                </span>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>Course</th>
                            <th>Classroom</th>
                            <th>Enrollment Code</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>@item.CourseName</td>

                                    <td>

                                        <strong>@item.ClassName</strong>

                                    </td>

                                    <td>

                                        <span class="badge bg-light text-dark">

                                            @item.EnrollmentCode

                                        </span>

                                    </td>

                                    <td>@item.StartDate.ToString("dd/MM/yyyy")</td>

                                    <td>@item.EndDate.ToString("dd/MM/yyyy")</td>

                                    <td>

                                        @if (item.Status == "OPEN")
                                        {
                                            <span class="badge bg-success">

                                                OPEN

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                @item.Status

                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Details"
                                           asp-route-id="@item.ClassroomId"
                                           class="btn btn-sm btn-outline-info"
                                           title="Details">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.ClassroomId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a asp-area="Teacher"
                                           asp-controller="Enrollment"
                                           asp-action="Index"
                                           asp-route-classroomId="@item.ClassroomId"
                                           class="btn btn-sm btn-outline-success"
                                           title="Students">

                                            <i class="bi bi-people"></i>

                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@item.ClassroomId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Delete this classroom?')">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5">

                                    <i class="bi bi-building display-5 text-muted"></i>

                                    <h5 class="mt-3">

                                        No classrooms found

                                    </h5>

                                    <p class="text-muted">

                                        Click "Create Classroom" to create your first classroom.

                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>