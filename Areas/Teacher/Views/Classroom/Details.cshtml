@model EduNexus.ViewModels.Assignment.ClassroomViewModel

@{
    ViewData["Title"] = "Classroom Details";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title mb-1">
                Classroom Details
            </h2>

            <p class="text-muted mb-0">
                View detailed information about this classroom.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>

            Back

        </a>

    </div>

    <div class="row">

        <!-- Main Content -->
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h5 class="mb-4">

                        <i class="bi bi-building me-2 text-primary"></i>

                        Classroom Information

                    </h5>

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label class="detail-label">
                                Course
                            </label>

                            <div class="detail-box">
                                @Model.CourseName
                            </div>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label class="detail-label">
                                Enrollment Code
                            </label>

                            <div class="detail-box">

                                <span class="badge bg-primary fs-6">

                                    @Model.EnrollmentCode

                                </span>

                            </div>

                        </div>

                    </div>

                    <div class="mb-4">

                        <label class="detail-label">
                            Classroom Name
                        </label>

                        <div class="detail-box">

                            @Model.ClassName

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label class="detail-label">
                                Start Date
                            </label>

                            <div class="detail-box">

                                @Model.StartDate.ToString("dd/MM/yyyy")

                            </div>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label class="detail-label">
                                End Date
                            </label>

                            <div class="detail-box">

                                @Model.EndDate.ToString("dd/MM/yyyy")

                            </div>

                        </div>

                    </div>

                    <div class="mb-2">

                        <label class="detail-label">
                            Status
                        </label>

                        <div class="detail-box">

                            @if (Model.Status == "OPEN")
                            {
                                <span class="badge bg-success fs-6">

                                    <i class="bi bi-check-circle-fill me-1"></i>

                                    OPEN

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">

                                    @Model.Status

                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Right Panel -->
        <div class="col-lg-4">

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body">

                    <h5>

                        <i class="bi bi-clipboard-data me-2 text-primary"></i>

                        Summary

                    </h5>

                    <hr />

                    <table class="table table-borderless mb-0">

                        <tr>

                            <td class="text-muted">
                                Course
                            </td>

                            <td class="text-end fw-semibold">
                                @Model.CourseName
                            </td>

                        </tr>

                        <tr>

                            <td class="text-muted">
                                Status
                            </td>

                            <td class="text-end">

                                @if (Model.Status == "OPEN")
                                {
                                    <span class="badge bg-success">
                                        OPEN
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @Model.Status
                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <td class="text-muted">
                                Duration
                            </td>

                            <td class="text-end">

                                @((Model.EndDate - Model.StartDate).Days)

                                days

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <a asp-action="Edit"
                       asp-route-id="@Model.ClassroomId"
                       class="btn btn-primary w-100 mb-2">

                        <i class="bi bi-pencil-square me-2"></i>

                        Edit Classroom

                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary w-100">

                        Back to List

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>