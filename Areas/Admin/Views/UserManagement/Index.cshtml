@model EduNexus.Areas.Admin.ViewModels.UserManagement.UserManagementIndexViewModel

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between
                align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">User Management</h1>

            <p class="text-muted mb-0">
                Manage user accounts and roles.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="UserManagement"
           asp-action="Create"
           class="btn btn-primary">
            Create Account
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get"
                  asp-area="Admin"
                  asp-controller="UserManagement"
                  asp-action="Index">

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">
                            Search
                        </label>

                        <input name="SearchText"
                               value="@Model.Filter.SearchText"
                               class="form-control"
                               placeholder="Name, email or username" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">
                            Role
                        </label>

                        <select name="RoleId"
                                class="form-select">
                            <option value="">
                                All roles
                            </option>

                            @foreach (var role in Model.Roles)
                            {
                                if (Model.Filter.RoleId ==
                                role.RoleId)
                                {
                                    <option value="@role.RoleId"
                                            selected>
                                        @role.RoleName
                                    </option>
                                }
                                else
                                {
                                    <option value="@role.RoleId">
                                        @role.RoleName
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">
                            User status
                        </label>

                        <select name="UserStatus"
                                class="form-select">
                            <option value="">
                                All statuses
                            </option>

                            <option value="ACTIVE"
                                    selected="@(Model.Filter.UserStatus == "ACTIVE")">
                                ACTIVE
                            </option>

                            <option value="INACTIVE"
                                    selected="@(Model.Filter.UserStatus == "INACTIVE")">
                                INACTIVE
                            </option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">
                            Account
                        </label>

                        <select name="IsAccountActive"
                                class="form-select">
                            <option value="">
                                All accounts
                            </option>

                            <option value="true"
                                    selected="@(Model.Filter.IsAccountActive == true)">
                                Active
                            </option>

                            <option value="false"
                                    selected="@(Model.Filter.IsAccountActive == false)">
                                Locked
                            </option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex
                                align-items-end gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Filter
                        </button>

                        <a asp-area="Admin"
                           asp-controller="UserManagement"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <strong>
                @Model.TotalItems account(s)
            </strong>
        </div>

        <div class="card-body p-0">
            @if (Model.Users.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    No users matched the selected filters.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover
                                      align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>User</th>
                                <th>Username</th>
                                <th>Role</th>
                                <th>User Status</th>
                                <th>Account</th>
                                <th>Last Login</th>
                                <th class="text-end">
                                    Action
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @user.FullName
                                        </div>

                                        <small class="text-muted">
                                            @user.Email
                                        </small>
                                    </td>

                                    <td>@user.Username</td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @user.RoleName
                                        </span>
                                    </td>

                                    <td>
                                        @if (user.UserStatus == "ACTIVE")
                                        {
                                            <span class="badge bg-success">
                                                ACTIVE
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                INACTIVE
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (user.IsAccountActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Locked
                                            </span>
                                        }
                                </td>

                                <td>
                                    @(user.LastLoginAt
                                                                    ?.ToString(
                                                                    "dd/MM/yyyy HH:mm")
                                                                    ?? "Never")
                            </td>

                                    <td class="text-end">
                                        <a asp-area="Admin"
                                           asp-controller="UserManagement"
                                           asp-action="Details"
                                           asp-route-id="@user.UserId"
                                           class="btn btn-sm
                                                          btn-outline-primary">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between
                                align-items-center">
                    <span class="text-muted">
                        Page @Model.Filter.Page
                        of @Model.TotalPages
                    </span>

                    <div class="btn-group">
                        @if (Model.HasPreviousPage)
                        {
                            <a asp-area="Admin"
                               asp-controller="UserManagement"
                               asp-action="Index"
                               asp-route-SearchText="@Model.Filter.SearchText"
                               asp-route-RoleId="@Model.Filter.RoleId"
                               asp-route-UserStatus="@Model.Filter.UserStatus"
                               asp-route-IsAccountActive="@Model.Filter.IsAccountActive"
                               asp-route-Page="@(Model.Filter.Page - 1)"
                               asp-route-PageSize="@Model.Filter.PageSize"
                               class="btn btn-outline-secondary">
                                Previous
                            </a>
                        }

                        @if (Model.HasNextPage)
                        {
                            <a asp-area="Admin"
                               asp-controller="UserManagement"
                               asp-action="Index"
                               asp-route-SearchText="@Model.Filter.SearchText"
                               asp-route-RoleId="@Model.Filter.RoleId"
                               asp-route-UserStatus="@Model.Filter.UserStatus"
                               asp-route-IsAccountActive="@Model.Filter.IsAccountActive"
                               asp-route-Page="@(Model.Filter.Page + 1)"
                               asp-route-PageSize="@Model.Filter.PageSize"
                               class="btn btn-outline-secondary">
                                Next
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>