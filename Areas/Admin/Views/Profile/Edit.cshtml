@model EduNexus.Areas.Admin.ViewModels.Profile.EditAdminProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">
            Account
        </div>

        <h2 class="page-title">
            Edit Profile
        </h2>

        <p class="page-description">
            Update your personal display information.
        </p>
    </div>

    <div class="page-actions">
        <a asp-area="Admin"
           asp-controller="Profile"
           asp-action="Index"
           class="btn-app-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to profile
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-4">
        <div class="app-card">
            <div class="app-card-header">
                <div>
                    <h3 class="app-card-title">
                        Avatar preview
                    </h3>

                    <p class="app-card-subtitle">
                        Preview of the current Avatar URL.
                    </p>
                </div>
            </div>

            <div class="app-card-body text-center py-5">
                <img id="avatarPreview"
                     src="@Model.AvatarUrl"
                     alt="Avatar preview"
                     style="
                        width: 130px;
                        height: 130px;
                        margin: 0 auto;
                        border-radius: 30px;
                        object-fit: cover;
                        border: 1px solid var(--border);
                        display:
                            @(string.IsNullOrWhiteSpace(
                                                     Model.AvatarUrl)
                                                         ? "none"
                                                         : "block");
                     " />

                <div id="avatarPlaceholder"
                     style="
                        width: 130px;
                        height: 130px;
                        margin: 0 auto;
                        align-items: center;
                        justify-content: center;
                        border-radius: 30px;
                        background: var(--accent-light);
                        color: var(--accent);
                        font-size: 48px;
                        display:
                            @(string.IsNullOrWhiteSpace(
                                                     Model.AvatarUrl)
                                                         ? "flex"
                                                         : "none");
                     ">

                    <i class="bi bi-person"></i>
                </div>

                <p class="text-muted small mt-4 mb-0">
                    Use an HTTP/HTTPS image URL or a local path
                    beginning with <code>/</code>.
                </p>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="app-card">
            <div class="app-card-header">
                <div>
                    <h3 class="app-card-title">
                        Profile information
                    </h3>

                    <p class="app-card-subtitle">
                        Email, username and role cannot be changed here.
                    </p>
                </div>
            </div>

            <div class="app-card-body">
                <form asp-area="Admin"
                      asp-controller="Profile"
                      asp-action="Edit"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="app-alert app-alert-danger mb-4">
                    </div>

                    <div class="mb-4">
                        <label asp-for="FullName"
                               class="form-label">
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               autocomplete="name"
                               placeholder="Enter your full name" />

                        <span asp-validation-for="FullName"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber"
                               class="form-label">
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control"
                               autocomplete="tel"
                               placeholder="Example: +84 912 345 678" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger small">
                        </span>

                        <div class="form-text">
                            Digits, spaces, parentheses,
                            plus and hyphen are accepted.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AvatarUrl"
                               class="form-label">
                        </label>

                        <input asp-for="AvatarUrl"
                               id="avatarUrlInput"
                               class="form-control"
                               placeholder="https://example.com/avatar.jpg" />

                        <span asp-validation-for="AvatarUrl"
                              class="text-danger small">
                        </span>

                        <div class="form-text">
                            Leave blank to remove the current avatar.
                        </div>
                    </div>

                    <div class="app-alert app-alert-info mb-4">
                        <div class="alert-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div class="alert-content">
                            <strong>
                                Account identity
                            </strong>

                            <span>
                                Email address, username, role and account
                                status are managed by the system and cannot
                                be edited from this form.
                            </span>
                        </div>
                    </div>

                    <div class="d-flex
                                justify-content-end
                                flex-wrap
                                gap-2">

                        <a asp-area="Admin"
                           asp-controller="Profile"
                           asp-action="Index"
                           class="btn-app-secondary">

                            Cancel
                        </a>

                        <button type="submit"
                                class="btn-app-primary">

                            <i class="bi bi-check-lg"></i>
                            Save changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const avatarInput =
                    document.getElementById(
                        "avatarUrlInput");

                const avatarPreview =
                    document.getElementById(
                        "avatarPreview");

                const avatarPlaceholder =
                    document.getElementById(
                        "avatarPlaceholder");

                function showPlaceholder() {
                    avatarPreview.style.display =
                        "none";

                    avatarPlaceholder.style.display =
                        "flex";
                }

                function showPreview(url) {
                    avatarPreview.src =
                        url;

                    avatarPreview.style.display =
                        "block";

                    avatarPlaceholder.style.display =
                        "none";
                }

                function updateAvatarPreview() {
                    const url =
                        avatarInput.value.trim();

                    if (!url) {
                        showPlaceholder();
                        return;
                    }

                    showPreview(url);
                }

                avatarPreview.addEventListener(
                    "error",
                    showPlaceholder);

                avatarInput.addEventListener(
                    "input",
                    updateAvatarPreview);

                updateAvatarPreview();
            });
    </script>
}