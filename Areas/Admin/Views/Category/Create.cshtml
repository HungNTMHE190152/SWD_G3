@model EduNexus.Areas.Admin.ViewModels.Category.CategoryFormViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">
            Course organization
        </div>

        <h2 class="page-title">
            Create Category
        </h2>

        <p class="page-description">
            Add a new category that SMEs can use
            when creating courses.
        </p>
    </div>

    <div class="page-actions">
        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="Index"
           class="btn-app-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to list
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <div class="form-card">
            <form asp-area="Admin"
                  asp-controller="Category"
                  asp-action="Create"
                  method="post">

                <partial name="~/Areas/Admin/Views/Category/_CategoryForm.cshtml"
                         model="Model" />

                <div class="d-flex gap-2 mt-4">
                    <button type="submit"
                            class="btn-app-primary">

                        <i class="bi bi-check-lg"></i>
                        Create category
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Category"
                       asp-action="Index"
                       class="btn-app-secondary">

                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-xl-4 mt-4 mt-xl-0">
        <div class="app-card">
            <div class="app-card-body">
                <div class="stat-icon mb-3">
                    <i class="bi bi-lightbulb"></i>
                </div>

                <h3 class="app-card-title mb-2">
                    Category guidelines
                </h3>

                <p class="app-card-subtitle">
                    Use clear, broad names that can include
                    several related courses.
                </p>

                <ul class="small text-muted ps-3 mb-0 mt-3">
                    <li class="mb-2">
                        Software Engineering
                    </li>

                    <li class="mb-2">
                        Information Technology
                    </li>

                    <li>
                        Business and Management
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}