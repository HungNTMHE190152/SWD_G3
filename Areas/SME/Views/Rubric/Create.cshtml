@model EduNexus.ViewModels.Assignment.RubricViewModel

@{
    ViewData["Title"] = "Create Rubric";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">

            <h3>Create Rubric</h3>
            <div class="alert alert-info mt-3">

                <strong>Assignment:</strong>

                @Model.AssignmentTitle

                <br />

                <strong>Total Score:</strong>

                @Model.TotalScore

            </div>

        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <input asp-for="AssignmentTemplateId" type="hidden" />

                <div class="mb-3">

                    <label asp-for="Title" class="form-label"></label>

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>

                </div>

                <div class="mb-4">

                    <label asp-for="Description"
                           class="form-label"></label>

                    <textarea asp-for="Description"
                              rows="3"
                              class="form-control"></textarea>

                </div>

                <hr />

                <h5>Criteria</h5>

                <table class="table table-bordered" id="criteriaTable">

                    <thead class="table-light">

                        <tr>

                            <th>Name</th>

                            <th>Description</th>

                            <th width="120">
                                Max Score
                            </th>

                            <th width="100">
                                Order
                            </th>

                            <th width="80"></th>

                        </tr>

                    </thead>

                    <tbody>
                    </tbody>

                </table>

                <button type="button"
                        class="btn btn-success mb-3"
                        id="btnAdd">

                    + Add Criterion

                </button>

                <br />

                <button class="btn btn-primary">

                    Save Rubric

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/rubric.js"></script>

}