@model EduNexus.ViewModels.Lesson.LessonResourceViewModel

@{
    ViewData["Title"] = "Edit Lesson Resource";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning">

            <h3>

                <i class="bi bi-pencil-square"></i>

                Edit Lesson Resource

            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                <input asp-for="LessonResourceId" hidden />

                <input asp-for="LessonId" hidden />

                <div class="mb-3">

                    <label asp-for="ResourceName"
                           class="form-label"></label>

                    <input asp-for="ResourceName"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="ResourceType"
                           class="form-label"></label>

                    <select asp-for="ResourceType"
                            class="form-select">

                        <option value="IMAGE">🖼 Image</option>

                        <option value="VIDEO">🎥 Video</option>

                        <option value="PDF">📄 PDF</option>

                        <option value="DOCUMENT">📑 Document</option>

                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label">

                        Replace File

                    </label>

                    <input asp-for="UploadFile"
                           class="form-control"
                           type="file" />

                    <small class="text-muted">

                        Không chọn file nếu muốn giữ file cũ.

                    </small>

                </div>

                <div class="mb-3">

                    <label asp-for="DisplayOrder"
                           class="form-label"></label>

                    <input asp-for="DisplayOrder"
                           class="form-control" />

                </div>

                <button class="btn btn-warning">

                    Save Changes

                </button>

                <a asp-action="Index"
                   asp-route-lessonId="@Model.LessonId"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}