@model EduNexus.Models.LessonResource

@{
    ViewData["Title"] = "Resource Details";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h3>

                <i class="bi bi-folder2-open"></i>

                @Model.ResourceName

            </h3>

        </div>

        <div class="card-body">

            <table class="table">

                <tr>

                    <th width="200">

                        Resource Name

                    </th>

                    <td>

                        @Model.ResourceName

                    </td>

                </tr>

                <tr>

                    <th>

                        Resource Type

                    </th>

                    <td>

                        <span class="badge bg-primary">

                            @Model.ResourceType

                        </span>

                    </td>

                </tr>

                <tr>

                    <th>

                        Display Order

                    </th>

                    <td>

                        @Model.DisplayOrder

                    </td>

                </tr>

            </table>

            <hr />

            @if (Model.ResourceType == "IMAGE")
            {
                <img src="@Model.ResourceUrl"
                     class="img-fluid rounded shadow" />
            }
            else if (Model.ResourceType == "VIDEO")
            {
                <video controls
                       width="100%">

                    <source src="@Model.ResourceUrl" />

                    Your browser does not support video.

                </video>
            }
            else if (Model.ResourceType == "PDF")
            {
                <iframe src="@Model.ResourceUrl"
                        width="100%"
                        height="700">
                </iframe>
            }
            else
            {
                <div class="alert alert-info">

                    This file cannot be previewed.

                    <br /><br />

                    <a href="@Model.ResourceUrl"
                       class="btn btn-primary"
                       target="_blank">

                        <i class="bi bi-download"></i>

                        Download File

                    </a>

                </div>
            }

        </div>

        <div class="card-footer text-end">

            <a asp-action="Edit"
               asp-route-id="@Model.LessonResourceId"
               class="btn btn-warning">

                <i class="bi bi-pencil"></i>

                Edit

            </a>

            <a asp-action="Index"
               asp-route-lessonId="@Model.LessonId"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>

                Back

            </a>

        </div>

    </div>

</div>