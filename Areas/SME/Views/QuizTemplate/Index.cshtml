@model IEnumerable<EduNexus.Models.QuizTemplate>

@{
    ViewData["Title"] = "Quiz Templates";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>

            <i class="bi bi-patch-question-fill text-primary"></i>

            Quiz Templates

        </h2>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>

            Create Quiz Template

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            @TempData["Success"]

        </div>
    }

    <div class="card shadow">

        <div class="card-body">

            <table class="table table-hover align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>Title</th>

                        <th>Course</th>

                        <th>Module</th>

                        <th>Duration</th>

                        <th>Passing</th>

                        <th>Questions</th>

                        <th>Status</th>

                        <th width="260">

                            Action

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center text-muted">

                                No Quiz Templates.

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <strong>

                                        @item.Title

                                    </strong>

                                </td>

                                <td>

                                    @item.Course?.Title

                                </td>

                                <td>

                                    @(item.Module?.Title ?? "-")

                                </td>

                                <td>

                                    @item.DefaultDurationMinutes min

                                </td>

                                <td>

                                    @item.DefaultPassingScore %

                                </td>

                                <td>

                                    @item.QuizTemplateQuestions.Count

                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">

                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            Inactive

                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.QuizTemplateId"
                                       class="btn btn-info btn-sm">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.QuizTemplateId"
                                       class="btn btn-warning btn-sm">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    <form asp-action="Delete"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input hidden
                                               name="id"
                                               value="@item.QuizTemplateId" />

                                        <button class="btn btn-danger btn-sm"
                                                onclick="return confirm('Delete this quiz template?')">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>