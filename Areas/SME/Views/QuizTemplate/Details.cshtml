@model EduNexus.Models.QuizTemplate

@{
    ViewData["Title"] = "Quiz Template Details";
}

<div class="container mt-4">

    <div class="row">

        <div class="col-lg-8">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">

                    <h3>

                        <i class="bi bi-patch-question-fill"></i>

                        @Model.Title

                    </h3>

                </div>

                <div class="card-body">

                    <table class="table">

                        <tr>

                            <th width="220">

                                Course

                            </th>

                            <td>

                                @Model.Course.Title

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Module

                            </th>

                            <td>

                                @(Model.Module?.Title ?? "All Modules")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Description

                            </th>

                            <td>

                                @Model.Description

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Duration

                            </th>

                            <td>

                                @Model.DefaultDurationMinutes minutes

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Passing Score

                            </th>

                            <td>

                                @Model.DefaultPassingScore %

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Max Attempts

                            </th>

                            <td>

                                @Model.DefaultMaxAttempts

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Shuffle Questions

                            </th>

                            <td>

                                @(Model.ShuffleQuestions ? "Yes" : "No")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Shuffle Answers

                            </th>

                            <td>

                                @(Model.ShuffleAnswers ? "Yes" : "No")

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Status

                            </th>

                            <td>

                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        Inactive

                                    </span>
                                }

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow">

                <div class="card-body">

                    <h5>

                        Statistics

                    </h5>

                    <hr />

                    <p>

                        Questions

                        <span class="float-end">

                            @Model.QuizTemplateQuestions.Count

                        </span>

                    </p>

                    <p>

                        Duration

                        <span class="float-end">

                            @Model.DefaultDurationMinutes min

                        </span>

                    </p>

                    <p>

                        Passing

                        <span class="float-end">

                            @Model.DefaultPassingScore %

                        </span>

                    </p>

                    <p>

                        Attempts

                        <span class="float-end">

                            @Model.DefaultMaxAttempts

                        </span>

                    </p>

                </div>

            </div>

            <div class="mt-3 d-grid gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.QuizTemplateId"
                   class="btn btn-warning">

                    <i class="bi bi-pencil"></i>

                    Edit

                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Back

                </a>

            </div>

        </div>

    </div>

    <div class="card shadow mt-4">

        <div class="card-header bg-dark text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5>

                    <i class="bi bi-list-check"></i>

                    Quiz Questions

                </h5>

                <a asp-area="SME"
                   asp-controller="QuizTemplateQuestion"
                   asp-action="Index"
                   asp-route-quizTemplateId="@Model.QuizTemplateId"
                   class="btn btn-success btn-sm">

                    <i class="bi bi-plus-circle"></i>

                    Manage Questions

                </a>

            </div>

        </div>

        <div class="card-body">

            @if (!Model.QuizTemplateQuestions.Any())
            {
                <div class="alert alert-info">

                    This quiz does not contain any questions.

                </div>
            }
            else
            {
                <table class="table table-hover">

                    <thead>

                        <tr>

                            <th>Question</th>

                            <th>Score</th>

                            <th>Order</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var q in Model.QuizTemplateQuestions.OrderBy(x => x.DisplayOrder))
                        {
                            <tr>

                                <td>

                                    @q.Question.QuestionContent

                                </td>

                                <td>

                                    @q.Score

                                </td>

                                <td>

                                    @q.DisplayOrder

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>