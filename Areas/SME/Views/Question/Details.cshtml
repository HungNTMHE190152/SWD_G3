@model EduNexus.Models.Question

@{
    ViewData["Title"] = "Question Details";
}

<div class="container mt-4">

    <div class="row">

        <div class="col-lg-8">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">

                    <h3>

                        <i class="bi bi-question-circle"></i>

                        Question Details

                    </h3>

                </div>

                <div class="card-body">

                    <table class="table">

                        <tr>

                            <th width="200">

                                Question

                            </th>

                            <td>

                                @Model.QuestionContent

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Question Type

                            </th>

                            <td>

                                @Model.QuestionType

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Difficulty

                            </th>

                            <td>

                                <span class="badge bg-info">

                                    @Model.Difficulty

                                </span>

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Explanation

                            </th>

                            <td>

                                @Model.Explanation

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Created

                            </th>

                            <td>

                                @Model.CreatedAt

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow">

                <div class="card-body">

                    <h5>

                        Statistics

                    </h5>

                    <hr />

                    <p>

                        Choices

                        <span class="float-end">

                            @Model.Choices.Count

                        </span>

                    </p>

                    <p>

                        Difficulty

                        <span class="float-end">

                            @Model.Difficulty

                        </span>

                    </p>

                    <p>

                        Type

                        <span class="float-end">

                            @Model.QuestionType

                        </span>

                    </p>

                </div>

            </div>

            <div class="mt-3 d-grid gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.QuestionId"
                   class="btn btn-warning">

                    <i class="bi bi-pencil"></i>

                    Edit Question

                </a>

                <a asp-action="Index"
                   asp-route-questionBankId="@Model.QuestionBankId"
                   class="btn btn-secondary">

                    Back

                </a>

            </div>

        </div>

    </div>

    <div class="card shadow mt-4">

        <div class="card-header bg-dark text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5>

                    <i class="bi bi-list-check"></i>

                    Choices

                </h5>

                <a asp-area="SME"
                   asp-controller="Choice"
                   asp-action="Create"
                   asp-route-questionId="@Model.QuestionId"
                   class="btn btn-success btn-sm">

                    <i class="bi bi-plus-circle"></i>

                    Add Choice

                </a>

            </div>

        </div>

        <div class="card-body">

            @if (!Model.Choices.Any())
            {
                <div class="alert alert-info">

                    No choices available.

                </div>
            }
            else
            {
                <table class="table table-hover">

                    <thead>

                        <tr>

                            <th>Content</th>

                            <th>Correct</th>

                            <th>Order</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var choice in Model.Choices.OrderBy(c => c.DisplayOrder))
                        {
                            <tr>

                                <td>

                                    @choice.ChoiceContent

                                </td>

                                <td>

                                    @if (choice.IsCorrect)
                                    {
                                        <span class="badge bg-success">

                                            ✔ Correct

                                        </span>
                                    }

                                </td>

                                <td>

                                    @choice.DisplayOrder

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>