@model EduNexus.ViewModels.QuestionBank.QuestionBankViewModel

@{
    ViewData["Title"] = "Edit Question Bank";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning">

            <h3>

                <i class="bi bi-pencil-square"></i>

                Edit Question Bank

            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="QuestionBankId" hidden />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="CourseId"
                           class="form-label fw-bold">

                        Course

                    </label>

                    <select asp-for="CourseId"
                            asp-items="ViewBag.Courses"
                            class="form-select">
                    </select>

                    <span asp-validation-for="CourseId"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="BankName"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="BankName"
                           class="form-control" />

                    <span asp-validation-for="BankName"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label fw-bold">
                    </label>

                    <textarea asp-for="Description"
                              rows="6"
                              class="form-control">
                    </textarea>

                </div>

                <div class="form-check mb-4">

                    <input asp-for="IsPublic"
                           class="form-check-input" />

                    <label asp-for="IsPublic"
                           class="form-check-label">

                        Public Question Bank

                    </label>

                </div>

                <hr />

                <div class="text-end">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-warning">

                        <i class="bi bi-check-circle"></i>

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}