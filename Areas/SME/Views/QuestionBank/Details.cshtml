@model EduNexus.Models.QuestionBank

@{
    ViewData["Title"] = "Question Bank Details";
}

<div class="container mt-4">

    <div class="row">

        <div class="col-lg-8">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">

                    <h3>

                        <i class="bi bi-collection"></i>

                        @Model.BankName

                    </h3>

                </div>

                <div class="card-body">

                    <table class="table">

                        <tr>

                            <th width="200">

                                Course

                            </th>

                            <td>

                                @Model.Course.Title

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Description

                            </th>

                            <td>

                                @Model.Description

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Status

                            </th>

                            <td>

                                @if (Model.IsPublic)
                                {
                                    <span class="badge bg-success">

                                        Public

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        Private

                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Created

                            </th>

                            <td>

                                @Model.CreatedAt

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow">

                <div class="card-body">

                    <h5>

                        Statistics

                    </h5>

                    <hr />

                    <p>

                        Questions

                        <span class="float-end">

                            @Model.Questions.Count

                        </span>

                    </p>

                    <p>

                        Course

                        <span class="float-end">

                            @Model.Course.Title

                        </span>

                    </p>

                    <p>

                        Visibility

                        <span class="float-end">

                            @(Model.IsPublic ? "Public" : "Private")

                        </span>

                    </p>

                </div>

            </div>

            <div class="mt-3 d-grid gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.QuestionBankId"
                   class="btn btn-warning">

                    <i class="bi bi-pencil"></i>

                    Edit

                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Back

                </a>

            </div>

        </div>

    </div>

    <div class="card shadow mt-4">

        <div class="card-header bg-dark text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5>

                    <i class="bi bi-question-circle"></i>

                    Questions

                </h5>

                <a asp-area="SME"
                   asp-controller="Question"
                   asp-action="Create"
                   asp-route-questionBankId="@Model.QuestionBankId"
                   class="btn btn-success btn-sm">

                    <i class="bi bi-plus-circle"></i>

                    Add Question

                </a>

            </div>

        </div>

        <div class="card-body">

            @if (Model.Questions.Count == 0)
            {
                <div class="alert alert-info">

                    No questions yet.

                </div>
            }
            else
            {
                <table class="table table-hover">

                    <thead>

                        <tr>

                            <th>Question</th>

                            <th>Difficulty</th>

                            <th>Type</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var q in Model.Questions)
                        {
                            <tr>

                                <td>

                                    @q.QuestionContent

                                </td>

                                <td>

                                    @q.Difficulty

                                </td>

                                <td>

                                    @q.QuestionType

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>