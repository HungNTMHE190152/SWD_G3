@{
    ViewData["Title"] = "Add Question";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">

            <h3>

                <i class="bi bi-plus-circle"></i>

                Add Question To Quiz

            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <input hidden
                       name="quizTemplateId"
                       value="@ViewBag.QuizTemplateId" />

                <div class="mb-3">

                    <label class="form-label fw-bold">

                        Question

                    </label>

                    <select name="questionId"
                            asp-items="ViewBag.Questions"
                            class="form-select">

                        <option value="">

                            -- Select Question --

                        </option>

                    </select>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                Score

                            </label>

                            <input name="score"
                                   value="1"
                                   type="number"
                                   step="0.5"
                                   class="form-control" />

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                Display Order

                            </label>

                            <input name="displayOrder"
                                   value="1"
                                   type="number"
                                   class="form-control" />

                        </div>

                    </div>

                </div>

                <hr />

                <div class="text-end">

                    <a asp-action="Index"
                       asp-route-quizTemplateId="@ViewBag.QuizTemplateId"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                    <button class="btn btn-success">

                        <i class="bi bi-check-circle"></i>

                        Save

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>