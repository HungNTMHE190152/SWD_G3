@model IEnumerable<EduNexus.Models.Course>

@{
    ViewData["Title"] = "Course Management";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="container-fluid">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                <i class="bi bi-book-half text-primary"></i>
                Course Management
            </h2>

            <p class="text-muted mb-0">
                Manage all your courses here.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>

            Create Course

        </a>

    </div>

    <!-- ALERT -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            @TempData["Success"]

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Error"]

        </div>
    }

    <!-- SEARCH -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-5">

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Search course..." />

                </div>

            </div>

        </div>

    </div>

    <!-- TABLE -->

    <div class="card shadow">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>Code</th>

                            <th>Title</th>

                            <th>Category</th>

                            <th>Modules</th>

                            <th>Status</th>

                            <th width="280">Action</th>

                        </tr>

                    </thead>

                    <tbody id="courseTable">

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <strong>@item.CourseCode</strong>

                                </td>

                                <td>

                                    @item.Title

                                </td>

                                <td>

                                    @item.Category.CategoryName

                                </td>

                                <td>

                                    @item.Modules.Count

                                </td>

                                <td>

                                    @switch (item.Status)
                                    {
                                        case "APPROVED":

                                            <span class="badge bg-success">

                                                Approved

                                            </span>

                                            break;

                                        case "REJECTED":

                                            <span class="badge bg-danger">

                                                Rejected

                                            </span>

                                            break;

                                        case "PENDING_REVIEW":

                                            <span class="badge bg-warning text-dark">

                                                Pending

                                            </span>

                                            break;

                                        default:

                                            <span class="badge bg-secondary">

                                                Draft

                                            </span>

                                            break;
                                    }

                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.CourseId"
                                       class="btn btn-info btn-sm">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.CourseId"
                                       class="btn btn-warning btn-sm">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    <form asp-action="SubmitForReview"
                                          method="post"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.CourseId" />

                                        <button class="btn btn-success btn-sm">

                                            <i class="bi bi-upload"></i>

                                        </button>

                                    </form>

                                    <form asp-action="Delete"
                                          method="post"
                                          class="d-inline">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.CourseId" />

                                        <button class="btn btn-danger btn-sm"
                                                onclick="return confirm('Delete this course?')">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        const search=document.getElementById("searchInput");

        search.addEventListener("keyup",function(){

        let value=this.value.toLowerCase();

        let rows=document.querySelectorAll("#courseTable tr");

        rows.forEach(function(r){

        r.style.display=r.innerText.toLowerCase().includes(value)
        ?"":"none";

        });

        });

    </script>

}