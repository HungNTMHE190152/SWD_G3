@model EduNexus.Models.Module

@{
    ViewData["Title"] = "Module Details";
}

<div class="container mt-4">

    <div class="row">

        <div class="col-lg-8">

            <div class="card shadow">

                <div class="card-header bg-info text-white">

                    <h3>

                        <i class="bi bi-folder2-open"></i>

                        @Model.Title

                    </h3>

                </div>

                <div class="card-body">

                    <table class="table">

                        <tr>

                            <th width="220">

                                Course

                            </th>

                            <td>

                                @Model.Course.Title

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Display Order

                            </th>

                            <td>

                                @Model.DisplayOrder

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Description

                            </th>

                            <td>

                                @Model.Description

                            </td>

                        </tr>

                        <tr>

                            <th>

                                Created

                            </th>

                            <td>

                                @Model.CreatedAt

                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow">

                <div class="card-body">

                    <h5>

                        Statistics

                    </h5>

                    <hr />

                    <p>

                        📚 Lessons

                        <span class="float-end">

                            @Model.Lessons.Count

                        </span>

                    </p>

                    <p>

                        📝 Quiz Templates

                        <span class="float-end">

                            @Model.QuizTemplates.Count

                        </span>

                    </p>

                </div>

            </div>

            <div class="mt-3 d-grid gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.ModuleId"
                   class="btn btn-warning">

                    Edit

                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Back

                </a>

            </div>

        </div>

    </div>

</div>
<hr />

<h5>

    Lessons

</h5>

<a asp-area="SME"
   asp-controller="Lesson"
   asp-action="Create"
   asp-route-moduleId="@Model.ModuleId"
   class="btn btn-success btn-sm mb-3">

    <i class="bi bi-plus-circle"></i>

    Add Lesson

</a>

<table class="table">

    <thead>

        <tr>

            <th>

                Order

            </th>

            <th>

                Title

            </th>

            <th>

                Type

            </th>

            <th>

                Action

            </th>

        </tr>

    </thead>

    <tbody>

        @foreach (var lesson in Model.Lessons.OrderBy(x => x.DisplayOrder))
        {

            <tr>

                <td>

                    @lesson.DisplayOrder

                </td>

                <td>

                    @lesson.Title

                </td>

                <td>

                    @lesson.LessonType

                </td>

                <td>

                    <a asp-area="SME"
                       asp-controller="Lesson"
                       asp-action="Details"
                       asp-route-id="@lesson.LessonId"
                       class="btn btn-info btn-sm">

                        View

                    </a>

                </td>

            </tr>

        }

    </tbody>

</table>