@model EduNexus.ViewModels.Module.ModuleViewModel

@{
    ViewData["Title"] = "Edit Module";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning">

            <h3>

                <i class="bi bi-pencil-square"></i>

                Edit Module

            </h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <input asp-for="ModuleId" hidden />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">

                    <label class="fw-bold">

                        Course

                    </label>

                    <select asp-for="CourseId"
                            asp-items="ViewBag.Courses"
                            class="form-select">
                    </select>

                </div>

                <div class="mb-3">

                    <label asp-for="Title"
                           class="fw-bold"></label>

                    <input asp-for="Title"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="fw-bold"></label>

<textarea asp-for="Description"
          rows="5"
          class="form-control"></textarea>

                </div>

                <div class="mb-3">

                    <label asp-for="DisplayOrder"
                           class="fw-bold"></label>

                    <input asp-for="DisplayOrder"
                           class="form-control" />

                </div>

                <hr />

                <div class="text-end">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Back

                    </a>

                    <button class="btn btn-warning">

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}